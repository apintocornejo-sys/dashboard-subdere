<html>
<head>
<title>Grilla Iniciativas</title>
<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
<link href="../../css/barra.css" rel="stylesheet" type="text/css" >
<link href="../../runtime/styles/xp/aw.css" rel="stylesheet" type="text/css" >
<script src="../../runtime/lib/aw.js"></script>
<link rel="stylesheet" href="../../css/estilos1.css" type="text/css">
<style>
   body, html {margin:0px; padding: 0px; overflow: hidden;}
//   .aw-alternate-even {background: #ffffff;}
//   .aw-alternate-odd {background: #FAFAFA;}
   .aw-scroll-top .active-box-item {background: #ccff99}
   .aw-scroll-left .active-box-item {background: #ffcc99}
   .aw-scroll-corner .active-box-item {background: #ff99cc}
   .aw-controls-grid {height: 100%; font: menu;}
   .aw-column-0 {width:  100px; text-align: center;cursor:hand;}
   .aw-column-1 {width: 280px;cursor:hand;}
   .aw-column-2 {width: 140px; text-align: left;cursor:hand;}
   .aw-column-3 {width: 135px; text-align: left;cursor:hand;}
   .aw-column-4 {width: 140px; cursor:hand;}
   .aw-column-5 {width: 100px; text-align: center;cursor:hand;}
   .aw-column-6 {width: 120px; text-align: right;cursor:hand;}
   .aw-column-7 {width: 90px; text-align: center;cursor:hand;border-left: darkgray 1px solid;}
   .aw-column-9 {width: 40px; text-align: center;cursor:hand;border-left: darkgray 1px solid;}
   .aw-column-13 {width: 110px; text-align: left;cursor:hand;}
   .aw-column-14 {width: 110px; text-align: left;cursor:hand;}
   .aw-column-15 {width: 110px; text-align: center;text-align: right;cursor:hand;}
   .aw-column-16 {width: 80px; text-align: center; cursor:hand;}
   .aw-column-18 {width: 80px; text-align: center; cursor:hand;}
   .aw-column-19 {width: 80px; text-align: center; cursor:hand;}
   .aw-column-20 {width: 80px; text-align: center; cursor:hand;}
   .aw-column-21 {width: 150px; text-align: left; cursor:hand;}
   .aw-column-22 {width: 150px; text-align: left; cursor:hand;}
   .aw-column-23 {width: 150px; text-align: left; cursor:hand;}
   .aw-grid-column {border-right: 1px solid threedlightshadow;}
   .aw-grid-row {border-bottom: 1px solid threedlightshadow;}
   .aw-grid-control {height: 100%; width: 100%; margin: 0px; font: menu;}
   .aw-row-selector {text-align: center;border-right: darkgray 1px solid;BACKGROUND: #EBEADB;font-size:9px; }
   .aw-grid-footer .aw-item-box {BACKGROUND: none transparent scroll repeat 0% 0%; BORDER-BOTTOM: medium none}
   .aw-grid-footer {	BORDER-TOP: darkgray 1px solid; BACKGROUND:#EBEADB; }
//   .aw-item-text {font-size: 10px;color: #555555;}
   .aw-grid-headers  {font-weight: bold; color:navy;}
   .aw-grid-header .aw-item-box {BACKGROUND: #000000 transparent scroll repeat 0% 0%; BORDER-BOTTOM: darkgray 1px solid;}
   .aw-rows-selected {background: #FFE28C!important; color: #000000!important;}
   .aw-grid-cell {border-right: darkgray 1px solid;border-bottom: darkgray 1px solid;}
   .aw-gpanel-top .aw-grid-header {TEXT-ALIGN: center}
</style>
<script>
   var Data11 = Array;
   var titulos11 = ["Id. Proyecto","Nombre del Proyecto","Tipo de Acci&oacute;n","Comuna","SubTipolog&iacute;a","Tipo de<br>Solicitud","Aporte<br>Subdere ($)","Estado","id","A&ntilde;o <br>Creaci&oacute;n","","","","Subprograma","Plan","","Fecha<br>Presentaci&oacute;n","","Priorizado<br>URS","Priorizado<br>Programa","Audiencia<br>Alcalde","","","","","","","","","","","Programa","","","","","","","Priorizaci&oacute;n Municipal","Fecha Aprobaci&oacute;n", "","","Revisi&oacute;n URS", "Observaci&oacute;n Programa", "Elegibilidad Programa"];
   var pie=['','104&nbsp;Iniciativas visualizadas','','','','','','','','','','','',''];
   
</script>
</head>
<body>

	<script src="../../include/wz_tooltip.js"></script>
<script>
   var filasel=-1;
   var obj = new AW.Grid.Extended;
   obj.setCellData(Data11);
   obj.setHeaderText(titulos11);
   obj.setColumnCount(titulos11.length-1);
   obj.setRowCount(Data11.length);
   obj.setFooterVisible(true);
   obj.setFooterText(pie);
   obj.setSelectorVisible(true);
   obj.setSelectorText(function(i){return this.getRowPosition(i)+1});
   obj.setSelectorWidth(30);
   obj.setSelectorWidth(28);
   obj.setHeaderHeight(40);
   obj.setFooterHeight(20);
   obj.setSelectionMode("single-row");
   obj.setVirtualMode(obj.getRowCount() > 20 ? true : false);
   obj.setFixedLeft(2);
   obj.setFixedRight(0);
      obj.setColumnIndices([9, 7, 1, 3, 6, 31, 13, 2, 4, 5, 14, 0, 39, 42, 43, 44]);
   var num = new AW.Formats.Number;
   num.setTextFormat("#.###,");
   obj.setCellFormat(num, 6);
   obj.getRowTemplate().setClass("text", "wrap");
   obj.getHeaderTemplate().setClass("text", "wrap");
   obj.setRowHeight(50);
   if (filasel!=-1) {
      var seleccionado=Array();
      seleccionado[0]=filasel;
      obj.setSelectedRows(seleccionado);
      obj.setCurrentRow(parseInt(seleccionado[0])-1);
   }

   obj.onCellMouseOver = function(event, col, row){
      if (col==18 || col==19 || col==20) { // (col==16 || col==19 || col==20)
         if (col==18) {var text = obj.getCellText(21,row);}
         if (col==19) {var text = obj.getCellText(22,row);}
         if (col==20) {var text = obj.getCellText(23,row);}
         if (text!="" && text!=null) {Tip(text, WIDTH, 400); }
      }
   }
   obj.onCellMouseOut = function(){
      UnTip();
   }

   if (obj.getRowCount()>0) {
      document.write(obj);
   } else {
      document.write("<br>");
      document.write("<table width='100%' border='0' align='center' cellpadding='0' cellspacing='0' class='tabla'><tr><td align='center'>");
      document.write('ï¿½ No existen Datos para la Consulta Solicitada !');
      document.write("</td></tr></table>");
   }
   parent.ocultar_mensaje();
   parent.configurar_resaltados();
</script>

</body>
</html>
