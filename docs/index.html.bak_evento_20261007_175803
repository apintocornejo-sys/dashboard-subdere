// ---------- Datos ----------
function hoyISO() { const h = new Date(); return `${h.getFullYear()}-${String(h.getMonth() + 1).padStart(2, '0')}-${String(h.getDate()).padStart(2, '0')}`; }

// Todas las entradas (calendario + manuales) dentro de la ventana de fechas; solo ya realizadas.
function entradasDespliegue() {
  const hoy = hoyISO();
  const normComuna = c => (c === 'PAIGUANO' ? 'PAIHUANO' : c);   // el mapa escribe "PAIHUANO" y SUBDERE "PAIGUANO"
  const todas = [...((VISITAS && VISITAS.visitas) || []).map(v => ({ ...v, origen: 'calendario' })),
                 ...((VISITAS_MANUALES && VISITAS_MANUALES.entradas) || []).map(v => ({ ...v, origen: 'manual' }))];
  return todas.map(v => ({ fecha: v.fecha, comuna: normComuna(v.comuna), tipo: v.tipo || 'reunion', online: !!v.online, origen: v.origen }))
              .filter(v => v.fecha >= VISITAS_DESDE && v.fecha <= hoy);
}
const pasaFiltrosDespliegue = v => despliegueFiltros.tipos.has(v.tipo) && despliegueFiltros.modalidades.has(v.online ? 'online' : 'presencial');

function datosDespliegue() {
  const todas = entradasDespliegue();
  const filtradas = todas.filter(pasaFiltrosDespliegue);
  // Una visita por comuna y por día (aunque ese día haya varias reuniones/ceremonias)
  const vistos = new Set();
  const unicas = filtradas.filter(v => { const k = `${v.fecha}|${v.comuna}`; if (vistos.has(k)) return false; vistos.add(k); return true; });

  const comunas = Object.keys(MAPA_COQUIMBO.comunas);
  const porComuna = {};
  comunas.forEach(c => porComuna[c] = { comuna: c, provincia: MAPA_COQUIMBO.comunas[c].provincia, n: 0, ultima: null, porMes: {} });
  unicas.filter(v => v.comuna !== ASOCIACION_CLAVE && porComuna[v.comuna]).forEach(v => {
    const c = porComuna[v.comuna]; c.n++;
    if (!c.ultima || v.fecha > c.ultima) c.ultima = v.fecha;
    const m = v.fecha.slice(0, 7); c.porMes[m] = (c.porMes[m] || 0) + 1;
  });
  const hoy = new Date();
  const hoyDia = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate());
  const mesActual = hoyISO().slice(0, 7);
  const meses = [];
  for (let y = 2026, m = 3; `${y}-${String(m).padStart(2, '0')}` <= mesActual; m++) {
    if (m > 12) { m = 1; y++; }
    meses.push(`${y}-${String(m).padStart(2, '0')}`);
    if (meses.length > 36) break;
  }
  const lista = Object.values(porComuna);
  lista.forEach(c => { c.dias = c.ultima ? Math.max(0, Math.round((hoyDia - new Date(c.ultima + 'T00:00:00')) / 86400000)) : null; });
  const total = lista.reduce((s, c) => s + c.n, 0);
  const mesesTranscurridos = Math.max(1, (hoyDia - new Date(2026, 2, 1)) / 86400000 / 30.44);
  const asociacion = unicas.filter(v => v.comuna === ASOCIACION_CLAVE);
  return { lista, porComuna, meses, mesActual, total, max: Math.max(1, ...lista.map(c => c.n)),
           promedioMensual: total / mesesTranscurridos, asociacion, todas, filtradas: filtradas.length };
}

const fmtFechaCorta = f => f ? f.split('-').reverse().join('-') : '—';
const txtDias = n => n === 0 ? 'Hoy' : n === 1 ? '1 día' : `${n} días`;
function colorMapa(n, max) {
  if (!n) return { fondo: '#3b3029', texto: '#E3D6C4', halo: '#2F2620' };
  const t = Math.min(1, n / max);
  const a = [90, 70, 52], b = [242, 193, 78];
  const rgb = a.map((v, i) => Math.round(v + (b[i] - v) * t));
  return t > 0.55 ? { fondo: `rgb(${rgb})`, texto: '#2F2620', halo: 'rgba(245,240,232,0.55)' }
                  : { fondo: `rgb(${rgb})`, texto: '#F5F0E8', halo: 'rgba(47,38,32,0.85)' };
}

function despliegueSeleccionar(comuna) { despliegueSel = despliegueSel === comuna ? null : comuna; renderDespliegue(); }
function toggleFiltroDespliegue(grupo, valor) {
  const set = despliegueFiltros[grupo];
  if (set.has(valor)) set.delete(valor); else set.add(valor);
  renderDespliegue();
}

// ---------- Dibujo ----------
function renderFiltrosDespliegue(d) {
  const cuenta = f => d.todas.filter(f).length;
  document.getElementById('chips-tipo').innerHTML = Object.entries(TIPOS_VISITA).map(([k, nombre]) =>
    `<span class="chip-filtro${despliegueFiltros.tipos.has(k) ? ' activo' : ''}" onclick="toggleFiltroDespliegue('tipos','${k}')">${nombre}<span class="n">${cuenta(v => v.tipo === k)}</span></span>`).join('');
  document.getElementById('chips-modalidad').innerHTML = [['presencial', 'Presencial', v => !v.online], ['online', 'Online (reuniones por videollamada)', v => v.online]].map(([k, nombre, f]) =>
    `<span class="chip-filtro${despliegueFiltros.modalidades.has(k) ? ' activo' : ''}" onclick="toggleFiltroDespliegue('modalidades','${k}')">${nombre}<span class="n">${cuenta(f)}</span></span>`).join('');
  document.getElementById('despliegue-filtro-nota').textContent =
    `Mostrando ${d.filtradas} de ${d.todas.length} registros (${d.total} visitas de comuna + ${d.asociacion.length} con la Asociación, contando una por comuna y día).`;
}

function renderDespliegue() {
  const el = document.getElementById('despliegue-mapa');
  if (!el) return;
  const d = datosDespliegue();
  renderFiltrosDespliegue(d);

  document.getElementById('despliegue-cinta').innerHTML = (VISITAS && VISITAS.cinta) ? `<span class="cinta-ejemplo">${VISITAS.cinta}</span>` : '';
  const gen = VISITAS && VISITAS.generado ? String(VISITAS.generado).slice(0, 10) : '';
  document.getElementById('despliegue-actualizado').textContent = gen ? `Calendario actualizado al ${fmtFechaCorta(gen)}.` : '';

  // ---- Indicadores ----
  const visitadas = d.lista.filter(c => c.n > 0).length;
  const sinVisita = d.lista.filter(c => c.n === 0).map(c => c.comuna);
  const top = [...d.lista].sort((a, b) => b.n - a.n)[0];
  document.getElementById('kpis-despliegue').innerHTML = `
    <div class="kpi"><div class="value">${d.total.toLocaleString('es-CL')}</div><div class="label">Visitas desde marzo 2026</div></div>
    <div class="kpi"><div class="value">${visitadas} de 15</div><div class="label">Comunas visitadas</div></div>
    <div class="kpi kpi-monto"><div class="value">${top.n ? top.comuna : '—'}</div><div class="label">Más visitada${top.n ? ` · ${top.n} visitas` : ''}</div></div>
    <div class="kpi" title="${sinVisita.join(', ')}"><div class="value" style="color:${sinVisita.length ? '#FF9C7A' : 'var(--accent)'}">${sinVisita.length}</div><div class="label">Comunas sin visitas${sinVisita.length ? `: ${sinVisita.join(', ')}` : ''}</div></div>
    <div class="kpi"><div class="value">${d.promedioMensual.toLocaleString('es-CL', { maximumFractionDigits: 1 })}</div><div class="label">Visitas por mes (promedio)</div></div>
  `;

  // ---- Mapa (primero todas las comunas, después las etiquetas; las sin visitas / seleccionada quedan encima) ----
  const trazos = [], trazosArriba = [], etiquetas = [];
  Object.entries(MAPA_COQUIMBO.comunas).forEach(([nombre, g]) => {
    const c = d.porComuna[nombre]; const col = colorMapa(c.n, d.max);
    const clases = ['mapa-comuna', c.n === 0 ? 'cero' : '', despliegueSel === nombre ? 'sel' : ''].join(' ').trim();
    const tip = `${nombre} — ${c.n} visita${c.n === 1 ? '' : 's'}${c.n ? ` (${(c.n / (d.total || 1) * 100).toFixed(1).replace('.', ',')}%) · última: ${fmtFechaCorta(c.ultima)}` : ' · sin visitas'}`;
    (c.n === 0 || despliegueSel === nombre ? trazosArriba : trazos).push(`<path class="${clases}" d="${g.d}" style="fill:${col.fondo}" onclick="despliegueSeleccionar('${nombre}')"><title>${tip}</title></path>`);
    const est = `fill:${col.texto};stroke:${col.halo};paint-order:stroke`;
    const usable = g.w * 0.6, ancho = 4.3, palabras = nombre.split(' ');
    let lineas = [nombre];
    if (nombre.length * ancho > usable && palabras.length > 1) {
      let mejor = null;
      for (let i = 1; i < palabras.length; i++) {
        const a = palabras.slice(0, i).join(' '), b = palabras.slice(i).join(' '), m = Math.max(a.length, b.length);
        if (!mejor || m < mejor.m) mejor = { a, b, m };
      }
      lineas = [mejor.a, mejor.b];
    }
    const largo = Math.max(...lineas.map(l => l.length));
    const fs = Math.max(5.2, Math.min(7.4, 7.4 * usable / (largo * ancho)));
    const tspans = lineas.map((l, i) => `<tspan x="${g.cx}" dy="${i === 0 ? 0 : (fs + 0.8).toFixed(1)}">${l}</tspan>`).join('');
    etiquetas.push(`<text class="mapa-num" x="${g.cx}" y="${g.cy + 2}" style="${est};stroke-width:2.6px">${c.n}</text>
      <text class="mapa-nom" x="${g.cx}" y="${g.cy + 12}" style="${est};stroke-width:2px;font-size:${fs.toFixed(1)}px">${tspans}</text>`);
  });
  el.innerHTML = `<svg class="mapa-svg" viewBox="${MAPA_COQUIMBO.viewBox}" role="img" aria-label="Mapa de visitas por comuna">${trazos.join('')}${trazosArriba.join('')}${etiquetas.join('')}</svg>`;
  document.getElementById('leyenda-max').textContent = d.max;

  // ---- Gráfico de comportamiento mensual ----
  const etqMeses = d.meses.map(m => MESES_CORTOS[+m.slice(5) - 1] + (m === d.mesActual ? '*' : ''));
