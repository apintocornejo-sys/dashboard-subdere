const EVENTO_GR_2026 = 'Transferencia Gobierno Regional 2026';
// Monto asignado a cada comuna (según el listado entregado, en el mismo
// orden: por provincia). Para corregir o actualizar un monto, edita el
// número de la comuna correspondiente aquí.
const ASIGNACION_GR_2026 = [
  ['ANDACOLLO', 430271555],
  ['COQUIMBO', 287107697],
  ['LA HIGUERA', 588458572],
  ['LA SERENA', 305958317],
  ['PAIGUANO', 433288779],
  ['VICUÑA', 341605631],
  ['COMBARBALÁ', 428729459],
  ['MONTE PATRIA', 420989211],
  ['OVALLE', 357375994],
  ['PUNITAQUI', 517106487],
  ['RÍO HURTADO', 478896468],
  ['CANELA', 410044093],
  ['ILLAPEL', 334102993],
  ['LOS VILOS', 315849570],
  ['SALAMANCA', 350215174],
];

function fmtPctGR(x) {
  return (x * 100).toLocaleString('es-CL', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + '%';
}
function fmtCLPn(n) { return (n < 0 ? '-' : '') + fmtCLP(Math.abs(n)); }
const fmtMillonesGR = v => '$' + Math.round(v / 1e6).toLocaleString('es-CL') + 'M';

// Cálculo único, compartido por la pestaña, el PDF y el Excel.
// Respeta los filtros activos del dashboard (igual que el resto de las pestañas).
function datosGR2026() {
  const comunasConocidas = new Set(ASIGNACION_GR_2026.map(([c]) => c));
  const delEvento = filtered.filter(d => d.evento === EVENTO_GR_2026);
  const proyectos = delEvento.filter(d => comunasConocidas.has(d.comuna));
  const sinComuna = delEvento.filter(d => !comunasConocidas.has(d.comuna));

  const filas = ASIGNACION_GR_2026.map(([comuna, asignado]) => {
    const delComuna = proyectos.filter(d => d.comuna === comuna);
    const postulado = delComuna.reduce((s, d) => s + (d.monto_subdere || 0), 0);
    return { comuna, asignado, postulado, saldo: asignado - postulado, pct: asignado ? postulado / asignado : 0, n: delComuna.length };
  });

  const totalAsignado = filas.reduce((s, f) => s + f.asignado, 0);
  const totalPostulado = filas.reduce((s, f) => s + f.postulado, 0);
  return {
    proyectos, filas, sinComuna,
    porEstado: groupBy(proyectos, 'estado').sort((a, b) => b.monto - a.monto),
    totales: {
      asignado: totalAsignado,
      postulado: totalPostulado,
      saldo: totalAsignado - totalPostulado,
      pct: totalAsignado ? totalPostulado / totalAsignado : 0,
      n: proyectos.length,
    },
  };
}

function renderGR2026() {
  const kpisEl = document.getElementById('kpis-gr2026');
