<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>SUBDERE Coquimbo — Dashboard de Proyectos</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<!-- Respaldo web de Century Gothic (se usa solo si el equipo no tiene Century Gothic instalada) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/jost/wght.css">
<style>
:root {
  /* Paleta: crema #F5F0E8 · arena #D8C3A5 · caramelo #B08A6A · café #7B5A43 · espresso #2F2620 */
  --bg:#1f1915; --panel:#2F2620; --panel-2:#3b3029; --border:#5a4636;
  --ink:#F5F0E8; --ink-dim:#BCAA95; --accent:#D8C3A5; --accent-2:#B08A6A;
  --accent-3:#7B5A43; --danger:#E0785A;
  --fuente:'Century Gothic','CenturyGothic','Jost Variable','Jost','Segoe UI',system-ui,-apple-system,sans-serif;
  --radius:18px;
}
* { box-sizing:border-box; }
body { margin:0; background:transparent; color:var(--ink); font-family:var(--fuente); letter-spacing:0; }
button, input, select, textarea { font-family:inherit; }
#fondo-decorativo { position:fixed; inset:0; width:100%; height:100%; z-index:-1; background-image:url(data:image/jpeg;base64,); background-size:cover; background-position:center; background-repeat:no-repeat; } #fondo-decorativo::after { content:''; position:absolute; inset:0; background:rgba(31,25,21,0.66); }
header { background:rgba(47,38,32,0.94); backdrop-filter:blur(2px); }
.sidebar {
  background:linear-gradient(165deg, #3b3029 0%, #4a392d 48%, #2a211c 100%);
}
.sidebar .tab { position:relative; z-index:1; }
.filters { background:rgba(59,48,41,0.92); backdrop-filter:blur(2px); position:relative; z-index:50; }
.panel, .kpi { background:rgba(47,38,32,0.93); backdrop-filter:blur(1px); }
header { padding:20px 28px 14px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:6px; background:var(--panel); }
header h1 { font-size:1.25rem; margin:0; font-weight:600; }
header .sub { color:var(--ink-dim); font-size:0.75rem; }
.badge-actualizado { display:flex; align-items:center; gap:7px; background:rgba(143,163,126,0.14); border:1px solid rgba(143,163,126,0.45); border-radius:20px; padding:5px 12px; font-size:0.78rem; color:#C9D8B8; font-weight:600; }
.badge-dot { width:8px; height:8px; border-radius:50%; background:#8FA37E; flex-shrink:0; animation:pulso-actualizado 2s ease-in-out infinite; }

/* ---------- Modo Reunión: pantalla simplificada para proyectar ---------- */
#btn-salir-reunion { position:fixed; top:16px; right:16px; z-index:200; background:#C8643C; color:#fff; border:none; border-radius:8px; padding:12px 20px; font-size:1rem; font-weight:700; cursor:pointer; box-shadow:0 4px 16px rgba(0,0,0,0.4); }
body.modo-reunion .sidebar,
body.modo-reunion .filters,
body.modo-reunion header,
body.modo-reunion #view-resumen > div:first-child,
body.modo-reunion .grid { display:none !important; }
body.modo-reunion .main-content { width:100%; }
body.modo-reunion .view { padding:40px 6vw; max-width:1400px; margin:0 auto; }
body.modo-reunion .kpis { grid-template-columns:repeat(4, 1fr); gap:24px; margin-bottom:24px; }
body.modo-reunion .kpi { padding:32px 24px; }
body.modo-reunion .kpi .value { font-size:4rem; }
body.modo-reunion .kpi .label { font-size:1.1rem; margin-top:10px; }
body.modo-reunion .panel-contraste { padding:24px; }
body.modo-reunion .panel-contraste h2 { font-size:1.4rem; }
body.modo-reunion .profesional-revision-grid { grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:20px; }
body.modo-reunion .profesional-card { padding:26px 20px; }
body.modo-reunion .profesional-card .num { font-size:5.2rem; }
body.modo-reunion .profesional-card .name { font-size:2.6rem; }
@keyframes pulso-actualizado { 0%,100% { opacity:1; box-shadow:0 0 0 0 rgba(143,163,126,0.5); } 50% { opacity:0.6; box-shadow:0 0 0 4px rgba(143,163,126,0); } }

.app-layout { display:flex; align-items:stretch; min-height:calc(100vh - 90px); }
.sidebar { width:200px; flex-shrink:0; border-right:1px solid var(--border); padding:14px 0; }
.main-content { flex:1; min-width:0; }

.filters { display:flex; flex-wrap:wrap; gap:10px; align-items:end; padding:16px 28px; background:var(--panel-2); border-bottom:1px solid var(--border); }
.filter-group { display:flex; flex-direction:column; gap:4px; min-width:150px; }
.filter-group label { font-size:0.7rem; color:var(--ink-dim); text-transform:uppercase; letter-spacing:.05em; }
select { background:var(--panel); color:var(--ink); border:1px solid var(--border); border-radius:12px; padding:8px 10px; font-size:0.85rem; }

.multiselect { position:relative; min-width:150px; }
.multiselect-btn { width:100%; text-align:left; background:var(--panel); color:var(--ink); border:1px solid var(--border); border-radius:12px; padding:8px 10px; font-size:0.85rem; cursor:pointer; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.multiselect-btn:after { content:'▾'; float:right; color:var(--ink-dim); }
.multiselect-panel { display:none; position:absolute; top:100%; left:0; margin-top:4px; background:var(--panel-2); border:1px solid var(--border); border-radius:14px; min-width:220px; max-height:260px; overflow-y:auto; z-index:30; padding:6px 0; box-shadow:0 12px 32px rgba(0,0,0,0.45); }
.multiselect-panel.open { display:block; }
.multiselect-option { display:flex; align-items:center; gap:8px; padding:7px 12px; font-size:0.84rem; cursor:pointer; }
.multiselect-option:hover { background:var(--panel); }
.multiselect-option input { margin:0; }
.multiselect-actions { display:flex; justify-content:space-between; padding:6px 12px 2px; border-top:1px solid var(--border); margin-top:4px; }
.multiselect-actions button { background:none; border:none; color:var(--ink-dim); font-size:0.75rem; cursor:pointer; padding:2px 4px; }
.multiselect-actions button:hover { color:var(--ink); }
.btn { border:none; border-radius:999px; padding:9px 20px; font-size:0.85rem; cursor:pointer; font-weight:600; }
.btn-primary { background:linear-gradient(135deg, #D8C3A5, #B08A6A); color:#2F2620; box-shadow:0 4px 14px rgba(176,138,106,0.35); }
.btn-ghost { background:var(--panel-2); color:var(--ink-dim); border:1px solid var(--border); }
.btn-modo-reunion { background:linear-gradient(135deg, #F2C14E, #D98E2B); color:#2F2620; font-weight:700; box-shadow:0 2px 12px rgba(217,142,43,0.5); }
.btn-modo-reunion:hover { box-shadow:0 3px 16px rgba(217,142,43,0.65); }
.result-count { color:var(--ink-dim); font-size:0.8rem; margin-left:auto; align-self:center; }

.tab { padding:11px 18px 11px 15px; font-size:0.85rem; color:var(--ink-dim); cursor:pointer; border-left:3px solid transparent; font-weight:500; transition:background-color .15s,color .15s; }
.tab:hover { color:var(--ink); background:var(--panel-2); }
.tab[data-view="resumen"].active { border-left-color:#D9A441; color:#D9A441; background:var(--panel-2); }
.tab[data-view="provincias"].active { border-left-color:#C8643C; color:#C8643C; background:var(--panel-2); }
.tab[data-view="programas"].active { border-left-color:#8FA37E; color:#8FA37E; background:var(--panel-2); }
.tab[data-view="evolucion"].active { border-left-color:#6FA3B5; color:#6FA3B5; background:var(--panel-2); }
.tab[data-view="tabla"].active { border-left-color:#B07AA1; color:#B07AA1; background:var(--panel-2); }
.tab[data-view="datos-extra"].active { border-left-color:#D8C3A5; color:#D8C3A5; background:var(--panel-2); }
.tab[data-view="trazabilidad"].active { border-left-color:#E0607E; color:#E0607E; background:var(--panel-2); }
.tab[data-view="gr2026"].active { border-left-color:#5FB3A7; color:#5FB3A7; background:var(--panel-2); }
.tab[data-view="despliegue"].active { border-left-color:#C6CF5E; color:#C6CF5E; background:var(--panel-2); }
.tab[data-view="rendiciones"].active { border-left-color:#9E94E0; color:#9E94E0; background:var(--panel-2); }

.view { display:none; padding:22px 28px 40px; }
.view.active { display:block; }

.kpis { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px; margin-bottom:20px; }
.kpi { background:var(--panel); border:1px solid var(--border); border-radius:var(--radius); padding:20px 22px; box-shadow:0 8px 24px rgba(0,0,0,0.3); }
.kpi .value { font-size:2.1rem; font-weight:700; color:var(--accent); letter-spacing:-0.02em; }
.kpi-clickeable { cursor:pointer; transition:transform .12s, box-shadow .12s; }
.kpi-clickeable:hover { transform:translateY(-2px); box-shadow:0 12px 28px rgba(0,0,0,0.4); }
.kpi-clickeable.expandido-kpi { outline:2px solid var(--accent); outline-offset:1px; }
.kpi .label { color:var(--ink-dim); font-size:0.75rem; text-transform:uppercase; letter-spacing:.05em; margin-top:4px; }

.grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(430px,1fr)); gap:16px; }
.grid > *, .view > *, .panel { min-width:0; }
.panel { background:var(--panel); border:1px solid var(--border); border-radius:var(--radius); padding:20px 22px; box-shadow:0 8px 24px rgba(0,0,0,0.3); transition:box-shadow .15s, transform .15s; }
.panel:hover { box-shadow:0 12px 32px rgba(0,0,0,0.4); }
.panel h2 { font-size:0.92rem; margin:0 0 12px; font-weight:600; color:var(--ink); }
.panel.wide { grid-column:1/-1; margin-bottom:20px; }

.panel-contraste { background:#3d231c; border:1px solid #C8643C; box-shadow:0 2px 10px rgba(200,100,60,0.25); }
.panel-trazabilidad { background:#3b1f28; border:1px solid #E0607E; box-shadow:0 2px 10px rgba(224,96,126,0.25); }
.panel-trazabilidad h2 { color:#F6BCCB; }
.panel-gr2026 { background:#1f3330; border:1px solid #5FB3A7; box-shadow:0 2px 10px rgba(95,179,167,0.22); }
.panel-gr2026 h2 { color:#BFE8E0; }
.panel-gr2026 p { margin:6px 0 10px; color:#CFE9E4; font-size:0.85rem; line-height:1.5; }
.barra-gr { height:4px; background:rgba(255,255,255,0.12); border-radius:2px; margin-top:3px; }
.barra-gr span { display:block; height:100%; background:#5FB3A7; border-radius:2px; }
.barra-gr.excede span { background:#D4553C; }
.fila-clic { cursor:pointer; }
.fila-clic:hover td { background:rgba(95,179,167,0.10); }
.fila-total td { font-weight:700; border-top:2px solid var(--border); }
.kpi.kpi-monto .value { font-size:1.35rem; }
.panel-despliegue { background:#2c3022; border:1px solid #C6CF5E; box-shadow:0 2px 10px rgba(198,207,94,0.2); }
.panel-despliegue h2 { color:#E3EAA6; }
.panel-despliegue p { margin:6px 0 0; color:#D9DFAF; font-size:0.85rem; line-height:1.5; }
.cinta-ejemplo { display:inline-block; background:#D4553C; color:#fff; font-weight:700; font-size:0.7rem; letter-spacing:.06em; padding:3px 10px; border-radius:999px; margin-left:10px; vertical-align:middle; }
.despliegue-layout { display:grid; grid-template-columns:minmax(300px,380px) 1fr; gap:16px; align-items:start; margin-bottom:16px; }
.despliegue-der { display:flex; flex-direction:column; gap:16px; min-width:0; }
.despliegue-der .kpis { margin-bottom:0; grid-template-columns:repeat(auto-fit,minmax(112px,1fr)); gap:10px; }
.despliegue-der .kpi { padding:14px 14px; }
.despliegue-der .kpi .value { font-size:1.55rem; }
.despliegue-der .kpi.kpi-monto .value { font-size:1.15rem; }
.mapa-svg { width:100%; height:auto; display:block; }
.mapa-comuna { cursor:pointer; stroke:#2F2620; stroke-width:1; transition:filter .15s; }
.mapa-comuna:hover { filter:brightness(1.18); stroke:#F5F0E8; }
.mapa-comuna.sel { stroke:#F5F0E8; stroke-width:2.6; }
.mapa-comuna.cero { stroke:#E0785A; stroke-dasharray:4 3; stroke-width:1.5; }
.mapa-num { font-weight:800; font-size:15px; text-anchor:middle; pointer-events:none; }
.mapa-nom { font-size:7.4px; font-weight:600; text-anchor:middle; pointer-events:none; letter-spacing:.02em; }
.leyenda-mapa { display:flex; align-items:center; gap:8px; font-size:0.72rem; color:var(--ink-dim); margin-top:10px; }
.leyenda-barra { flex:1; height:8px; border-radius:4px; background:linear-gradient(90deg,#5a4634,#F2C14E); }
.chip-dias { display:inline-block; padding:2px 9px; border-radius:999px; font-size:0.72rem; font-weight:700; white-space:nowrap; }
.chip-ok { background:rgba(143,163,126,0.22); color:#C9D8B8; }
.chip-medio { background:rgba(217,164,65,0.22); color:#F2D58A; }
.chip-alto { background:rgba(212,85,60,0.25); color:#FFB8A6; }
.fila-sel td { background:rgba(198,207,94,0.14); }
.asoc-meses { display:flex; align-items:flex-end; gap:6px; height:52px; }
.asoc-meses div { flex:1; background:#C6CF5E; border-radius:3px 3px 0 0; min-height:3px; }
.asoc-etq { display:flex; gap:6px; margin-top:4px; }
.asoc-etq span { flex:1; text-align:center; font-size:0.62rem; color:var(--ink-dim); }
.filtros-despliegue { display:flex; flex-wrap:wrap; gap:14px 28px; align-items:center; padding-top:14px; padding-bottom:14px; }
.filtro-grupo { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
.filtro-titulo { font-size:0.72rem; text-transform:uppercase; letter-spacing:.08em; color:var(--ink-dim); }
.chips { display:flex; gap:8px; flex-wrap:wrap; }
.chip-filtro { cursor:pointer; user-select:none; padding:6px 14px; border-radius:999px; font-size:0.8rem; font-weight:600; border:1px solid var(--border); background:var(--panel-2); color:var(--ink-dim); transition:all .12s; }
.chip-filtro:hover { border-color:#C6CF5E; color:var(--ink); }
.chip-filtro.activo { background:#C6CF5E; color:#2F2620; border-color:#C6CF5E; }
.chip-filtro .n { opacity:.75; font-weight:500; margin-left:6px; font-size:0.72rem; }
.filtro-nota { flex-basis:100%; font-size:0.74rem; color:var(--ink-dim); }
.panel-ingreso { border:1px solid #C6CF5E55; }
.form-visita { display:grid; grid-template-columns:repeat(4, 1fr); gap:12px; }
.form-visita .form-field.wide { grid-column:1 / -1; }
.aviso-ingreso { background:#3d231c; border:1px solid #C8643C; color:#F7D9C9; border-radius:8px; padding:10px 12px; font-size:0.82rem; margin-bottom:12px; }
.btn-borrar { background:transparent; border:1px solid #C8643C88; color:#FFB8A6; border-radius:999px; padding:3px 12px; font-size:0.72rem; cursor:pointer; }
.btn-borrar:hover { background:#C8643C33; }
@media (max-width:768px) { .form-visita { grid-template-columns:1fr; } }
.panel-rend { background:#2a2740; border:1px solid #9E94E0; box-shadow:0 2px 10px rgba(158,148,224,0.2); }
.panel-rend h2 { color:#DAD5F7; }
.panel-rend p { margin:6px 0 0; color:#CFCAEF; font-size:0.85rem; line-height:1.5; }
.rf-aviso { margin-top:10px; background:rgba(0,0,0,0.22); border:1px solid #9E94E055; border-radius:8px; padding:8px 12px; font-size:0.76rem; color:#CFCAEF; }
.rf-aviso summary { cursor:pointer; font-weight:600; }
.rf-aviso ul { margin:6px 0 0 18px; padding:0; }
.rf-filtros { position:relative; z-index:55; }   /* para que los desplegables queden por encima de los indicadores */
.rf-filtros-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:12px 14px; }
.rf-filtros-pie { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-top:12px; }
.rf-campo label { display:block; font-size:0.68rem; text-transform:uppercase; letter-spacing:.07em; color:var(--ink-dim); margin-bottom:4px; }
.rf-campo.doble { grid-column:span 2; }
.rf-campo input[type=date] { width:100%; box-sizing:border-box; }
.rf-fechas input { flex:1; min-width:0; }
.rf-fechas { display:flex; gap:6px; }
.rf-ms { position:relative; }
.rf-ms-btn { width:100%; text-align:left; background:var(--panel-2); color:var(--ink); border:1px solid var(--border); border-radius:10px; padding:8px 12px; font-size:0.84rem; cursor:pointer; display:flex; justify-content:space-between; gap:8px; }
.rf-ms-btn.activo { border-color:#9E94E0; box-shadow:0 0 0 2px rgba(158,148,224,0.25); }
.rf-ms-panel { display:none; position:absolute; z-index:60; top:calc(100% + 4px); left:0; min-width:100%; width:max-content; max-width:360px; background:var(--panel); border:1px solid #9E94E0; border-radius:10px; box-shadow:0 8px 24px rgba(0,0,0,0.5); padding:8px; }
.rf-ms.abierto .rf-ms-panel { display:block; }
.rf-ms-panel input[type=text] { width:100%; box-sizing:border-box; margin-bottom:6px; }
.rf-ms-lista { max-height:240px; overflow-y:auto; }
.rf-ms-lista label { display:flex; gap:8px; align-items:flex-start; padding:4px 6px; font-size:0.8rem; cursor:pointer; border-radius:6px; color:var(--ink); text-transform:none; letter-spacing:0; margin:0; }
.rf-ms-lista label:hover { background:rgba(158,148,224,0.18); }
.rf-ms-acciones { display:flex; justify-content:space-between; margin-top:6px; font-size:0.72rem; }
.rf-ms-acciones a { color:#B9B1F2; cursor:pointer; text-decoration:underline; }
.kpi .sub { font-size:0.68rem; color:var(--ink-dim); margin-top:4px; }
#rf-kpis { grid-template-columns:repeat(auto-fit,minmax(235px,1fr)); }
#rf-kpis .kpi-monto .value { font-size:1.2rem; overflow-wrap:anywhere; }
.rf-metrica-barra { display:flex; align-items:center; gap:12px; flex-wrap:wrap; padding-top:12px; padding-bottom:12px; }
.chip-filtro.rf-chip:hover { border-color:#9E94E0; }
.chip-filtro.rf-chip.activo { background:#9E94E0; border-color:#9E94E0; color:#26233a; }
.chip-filtro.deshabilitado { opacity:.4; cursor:not-allowed; }
.rf-alerta-cab { display:flex; gap:14px; flex-wrap:wrap; margin:8px 0 10px; }
.rf-alerta-caja { flex:1; min-width:220px; border-radius:12px; padding:12px 16px; }
.rf-alerta-caja.roja { background:#3d231c; border:1px solid #C8643C; }
.rf-alerta-caja.ocre { background:#3b3220; border:1px solid #D9A441; }
.rf-alerta-caja .cifra { font-size:1.9rem; font-weight:700; line-height:1.1; }
.rf-alerta-caja.roja .cifra { color:#FF9C7A; } .rf-alerta-caja.ocre .cifra { color:#F2C14E; }
.rf-alerta-caja .txt { font-size:0.78rem; color:var(--ink-dim); margin-top:2px; }
.rf-tabla-barra { display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:10px; }
.rf-tabla-barra #rf-buscador { flex:1; min-width:240px; }
.rf-paginacion { display:flex; align-items:center; gap:8px; font-size:0.78rem; color:var(--ink-dim); }
#tbl-rf th { cursor:pointer; white-space:nowrap; user-select:none; }
#tbl-rf th.orden::after { content:' ▲'; font-size:0.65rem; } #tbl-rf th.orden.desc::after { content:' ▼'; }
#tbl-rf td.nombre { max-width:320px; min-width:200px; font-size:0.78rem; }
#tbl-rf td.neg { color:#FF9C7A; }
#tbl-rf tr.rf-vencido td:first-child { box-shadow:inset 3px 0 0 #C8643C; }
#tbl-rf tr.rf-porvencer td:first-child { box-shadow:inset 3px 0 0 #D9A441; }
.rf-mini td, .rf-mini th { font-size:0.78rem; }

.rf-botones { display:flex; justify-content:center; gap:10px; margin-bottom:14px; flex-wrap:wrap; }
/* ---------- Modo Reunión de Rendiciones ---------- */
#rf-reunion { display:none; }
body.modo-reunion-rend #rf-reunion { display:block; }
body.modo-reunion-rend .sidebar, body.modo-reunion-rend .filters, body.modo-reunion-rend header { display:none !important; }
body.modo-reunion-rend .main-content { width:100%; }
body.modo-reunion-rend #view-rendiciones > :not(#rf-reunion) { display:none !important; }
body.modo-reunion-rend #view-rendiciones { padding:62px 2vw 22px; max-width:none; margin:0 auto; }
#btn-salir-rend { display:none; position:fixed; top:14px; right:16px; z-index:200; background:#C8643C; color:#fff; border:none; border-radius:8px; padding:12px 20px; font-size:1rem; font-weight:700; cursor:pointer; box-shadow:0 4px 14px rgba(0,0,0,0.45); }
