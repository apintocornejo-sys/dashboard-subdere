// Imagen de un gráfico para el PDF: en pantalla usa letra clara sobre fondo oscuro, que en una hoja blanca no se lee.
// Se aplica un "tema de impresión" (letra oscura y más grande, fondo blanco, nítido) SOLO mientras se captura.
// Chart.js regenera sus objetos de escala en cada update(), así que no se restaura "valor por valor": se guarda una copia
// de las opciones antes de tocarlas y se repone completa al terminar.
function imagenChartImpresion(chart, anchoMm) {
  if (!chart.width || !chart.height) return { data: chart.toBase64Image('image/png', 1.0), w: chart.canvas.width, h: chart.canvas.height, tipo: 'PNG' };
  const clonar = v => {
    if (Array.isArray(v)) return v.map(clonar);
    if (v && typeof v === 'object') { const p = Object.getPrototypeOf(v); if (p === Object.prototype || p === null) { const r = {}; Object.keys(v).forEach(k => { r[k] = clonar(v[k]); }); return r; } }
    return v;
  };
  const o = chart.config.options || (chart.config.options = {});
  const respaldo = { scales: clonar(o.scales), plugins: clonar(o.plugins), tieneDpr: 'devicePixelRatio' in o, dpr: o.devicePixelRatio, tieneAnim: 'animation' in o, anim: o.animation };
  const dsCambios = [];   // las etiquetas propias de cada dataset (ds.datalabels) son objetos estables: se restauran uno a uno
  const fijarDs = (obj, clave, valor) => { const tenia = Object.prototype.hasOwnProperty.call(obj, clave), antes = obj[clave]; obj[clave] = valor; dsCambios.push(() => { if (tenia) obj[clave] = antes; else delete obj[clave]; }); };
  const aseg = (obj, clave) => { if (obj[clave] === undefined || obj[clave] === null) obj[clave] = {}; return obj[clave]; };
  const letra = (obj, tam, peso) => { const f = (obj.font && typeof obj.font === 'object') ? obj.font : {}; obj.font = Object.assign({}, f, { size: tam, weight: peso || f.weight || '500' }); };
  const TINTA = '#1f2430', REJILLA = '#d6d9df';
  chart.stop();   // si el gráfico se acaba de dibujar, se termina su animación para que el cambio de estilo se pinte de inmediato
  const escalas = aseg(o, 'scales');
  Object.keys(chart.scales || {}).forEach(id => {
    const sc = aseg(escalas, id), t = aseg(sc, 'ticks'); t.color = TINTA; letra(t, 14); t.autoSkip = false;
    const g = aseg(sc, 'grid'); if (g.display !== false) g.color = REJILLA;
    if (sc.title && sc.title.display) { sc.title.color = TINTA; letra(sc.title, 14, '600'); }
  });
  const pl = aseg(o, 'plugins');
  const lb = aseg(aseg(pl, 'legend'), 'labels'); lb.color = TINTA; letra(lb, 14);
  const dl = aseg(pl, 'datalabels'); dl.color = TINTA; dl.backgroundColor = null; letra(dl, 13, '700');
  (chart.data.datasets || []).forEach(ds => {
    if (ds.type === 'line' || (chart.config.type === 'line' && !ds.type)) { fijarDs(ds, 'borderColor', '#3d4455'); fijarDs(ds, 'backgroundColor', '#3d4455'); }   // las líneas claras no se ven sobre blanco
    if (ds.datalabels && typeof ds.datalabels === 'object') {
    const f = (ds.datalabels.font && typeof ds.datalabels.font === 'object') ? ds.datalabels.font : {};
    fijarDs(ds.datalabels, 'color', TINTA); fijarDs(ds.datalabels, 'backgroundColor', null); fijarDs(ds.datalabels, 'font', Object.assign({}, f, { size: 13, weight: '700' })); }
  });
  const w0 = chart.width, h0 = chart.height, wPx = Math.min(1100, Math.max(520, Math.round((anchoMm || 120) * 5.2)));
  o.devicePixelRatio = 2; o.animation = false;
  try {
    chart.resize(wPx, Math.round(h0 * wPx / w0)); chart.update('none');
    const c = chart.canvas, lienzo = document.createElement('canvas'); lienzo.width = c.width; lienzo.height = c.height;
    const ctx = lienzo.getContext('2d'); ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, lienzo.width, lienzo.height); ctx.drawImage(c, 0, 0);
    return { data: lienzo.toDataURL('image/jpeg', 0.93), w: lienzo.width, h: lienzo.height, tipo: 'JPEG' };
  } finally {
    dsCambios.reverse().forEach(fn => fn());
    const o2 = chart.config.options;
    if (respaldo.scales === undefined) delete o2.scales; else o2.scales = respaldo.scales;
    if (respaldo.plugins === undefined) delete o2.plugins; else o2.plugins = respaldo.plugins;
    if (respaldo.tieneDpr) o2.devicePixelRatio = respaldo.dpr; else delete o2.devicePixelRatio;
    if (respaldo.tieneAnim) o2.animation = respaldo.anim; else delete o2.animation;
    chart.resize(); chart.update('none');
  }
}

function agregarImagenChart(doc, chartId, x, y, maxW, maxH, titulo) {
  const chart = charts[chartId];
  doc.setFontSize(9);
  doc.setTextColor(70, 70, 70);
  doc.text(titulo, x, y);
  if (!chart || !chart.canvas || !chart.canvas.width) {
    doc.setDrawColor(200); doc.rect(x, y + 2, maxW, maxH);
    doc.setFontSize(8); doc.text('(sin datos)', x + 2, y + maxH / 2);
    return;
  }
  const img = imagenChartImpresion(chart, maxW);
  const pxW = img.w, pxH = img.h;
  let w = maxW, h = (pxH / pxW) * w;
  if (h > maxH) { h = maxH; w = (pxW / pxH) * h; }
  const offsetX = x + (maxW - w) / 2;
  doc.addImage(img.data, img.tipo || 'JPEG', offsetX, y + 2, w, h);
}

function generarInformeResumenConLogo(jsPDF, logoW, logoH) {
  const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'letter' });
  doc.setFont('helvetica', 'normal'); // Century Gothic no disponible en el PDF; Helvetica es la alternativa geométrica más cercana
  const marginX = 14;
  const pageW = 279.4;
  const contentW = pageW - marginX * 2;
  let textoX = marginX;

  if (logoW && logoH) {
    const alturaLogo = 15;
    const anchoLogo = alturaLogo * (logoW / logoH);
    doc.addImage(`data:image/jpeg;base64,${LOGO_BASE64}`, 'JPEG', marginX, 8, anchoLogo, alturaLogo);
    textoX = marginX + anchoLogo + 6;
  }

  // Título en dos líneas (más robusto que una sola línea larga: nunca se corta)
  doc.setFont(undefined, 'bold');
  doc.setFontSize(14);
  doc.setTextColor(35, 49, 108);
  doc.text('SUBDERE en Línea', textoX, 13);
  doc.setFontSize(11);
  doc.setTextColor(70, 80, 120);
  doc.text('Informe de Resumen — Región de Coquimbo', textoX, 19.5);
  doc.setFont(undefined, 'normal');

  doc.setFontSize(8.5);
  doc.setTextColor(110, 110, 110);
  doc.text(`Generado el ${new Date().toLocaleDateString('es-CL')}`, textoX, 25);

  let y = 30;

  // ---- Recuadro de contraste: filtros aplicados + KPIs (azul institucional) ----
  doc.setFontSize(8);
  const filtrosLineas = doc.splitTextToSize(`Filtros aplicados: ${resumenFiltrosActivos()}`, contentW - 8).slice(0, 2);
  const alturaFiltrosCaja = 6 + filtrosLineas.length * 4;

  doc.setFillColor(24, 34, 74);
  doc.setDrawColor(70, 90, 160);
  doc.roundedRect(marginX, y, contentW, alturaFiltrosCaja, 1.5, 1.5, 'FD');
  doc.setFontSize(8);
  doc.setTextColor(210, 216, 240);
  doc.text(filtrosLineas, marginX + 4, y + 5);
  y += alturaFiltrosCaja + 5;

  // ---- Tarjetas de KPI (estilo tablero moderno) ----
  const enRevisionURS = filtered.filter(d => d.estado === 'En Revisión URS').length;
  const enEvaluacionTecnica = filtered.filter(d => d.estado === 'En Evaluación Técnica').length;
  const elegibles = filtered.filter(d => d.estado === 'Elegible').length;
  const kpis = [
    { label: 'Proyectos', valor: filtered.length, color: [79, 178, 168] },
    { label: 'En Revisión URS', valor: enRevisionURS, color: [201, 87, 107] },
    { label: 'En Evaluación Técnica', valor: enEvaluacionTecnica, color: [214, 140, 69] },
    { label: 'Elegibles', valor: elegibles, color: [91, 141, 217] },
  ];
  const gapKpi = 6;
  const kpiW = (contentW - gapKpi * 3) / 4;
  const kpiH = 20;
  kpis.forEach((k, i) => {
    const kx = marginX + i * (kpiW + gapKpi);
    doc.setFillColor(245, 246, 249);
    doc.setDrawColor(225, 227, 232);
    doc.roundedRect(kx, y, kpiW, kpiH, 1.5, 1.5, 'FD');
    doc.setFillColor(k.color[0], k.color[1], k.color[2]);
    doc.roundedRect(kx, y, 2.2, kpiH, 1, 1, 'F'); // ribete de color a la izquierda
    doc.setFontSize(15);
    doc.setTextColor(k.color[0], k.color[1], k.color[2]);
    doc.setFont(undefined, 'bold');
    doc.text(String(k.valor.toLocaleString('es-CL')), kx + 6, y + 11);
    doc.setFont(undefined, 'normal');
    doc.setFontSize(7.5);
    doc.setTextColor(90, 90, 95);
    doc.text(k.label, kx + 6, y + 16.5, { maxWidth: kpiW - 8 });
  });
  y += kpiH + 6;

  // ---- Tarjetas: proyectos "En Revisión URS" por profesional ----
  // Mismo formato visual que las tarjetas de KPI de arriba (ribete de color,
  // número grande, etiqueta abajo), una tarjeta por profesional.
  const conteoProfesional = {};
  filtered.filter(d => d.estado === 'En Revisión URS').forEach(d => {
    const nombre = d.profesional && d.profesional.trim() !== '' ? d.profesional : 'Sin asignar';
    conteoProfesional[nombre] = (conteoProfesional[nombre] || 0) + 1;
  });
  const tarjetasProfesional = Object.entries(conteoProfesional).sort((a,b) => b[1]-a[1]);

  doc.setFontSize(9.5);
  doc.setTextColor(35, 49, 108);
  doc.setFont(undefined, 'bold');
  doc.text('Proyectos "En Revisión URS" por Profesional', marginX, y);
  doc.setFont(undefined, 'normal');
  y += 5;

  if (tarjetasProfesional.length === 0) {
    doc.setFontSize(8.5);
    doc.setTextColor(120, 120, 120);
    doc.text('Sin proyectos en este estado en la vista actual.', marginX, y + 4);
    y += 12;
  } else {
    const gapProf = 6;
    const maxPorFila = 6;
    const nCols = Math.min(tarjetasProfesional.length, maxPorFila);
    const profW = (contentW - gapProf * (nCols - 1)) / nCols;
    const profH = 20;
    const colorProf = [201, 87, 107];
    tarjetasProfesional.forEach(([nombre, n], i) => {
      const fila = Math.floor(i / maxPorFila);
      const col = i % maxPorFila;
      const px = marginX + col * (profW + gapProf);
      const py = y + fila * (profH + 5);
      doc.setFillColor(245, 246, 249);
      doc.setDrawColor(225, 227, 232);
      doc.roundedRect(px, py, profW, profH, 1.5, 1.5, 'FD');
      doc.setFillColor(colorProf[0], colorProf[1], colorProf[2]);
      doc.roundedRect(px, py, 2.2, profH, 1, 1, 'F');
      doc.setFontSize(15);
      doc.setTextColor(colorProf[0], colorProf[1], colorProf[2]);
      doc.setFont(undefined, 'bold');
      doc.text(String(n), px + 6, py + 11);
      doc.setFont(undefined, 'normal');
      doc.setFontSize(7);
      doc.setTextColor(90, 90, 95);
      doc.text(nombre, px + 6, py + 16.5, { maxWidth: profW - 8 });
    });
    const filas = Math.ceil(tarjetasProfesional.length / maxPorFila);
    y += filas * (profH + 5) + 1;
  }

  // ---- Gráficos: 3 en una sola fila, a mayor tamaño (se quitó "Distribución
  // por programa" para dejarles más espacio a los 3 restantes) ----
  const gapChart = 8;
  const colW3 = (contentW - gapChart * 2) / 3;
  const rowH = 78;
  const c1X = marginX, c2X = marginX + colW3 + gapChart, c3X = marginX + (colW3 + gapChart) * 2;

  agregarImagenChart(doc, 'chartEstado', c1X, y, colW3, rowH, 'Distribución por estado');
  agregarImagenChart(doc, 'chartAportePorProvincia', c2X, y, colW3, rowH, 'Aporte SUBDERE por provincia');
  agregarImagenChart(doc, 'chartEvento', c3X, y, colW3, rowH, 'Distribución por evento');
  y += rowH + 8;

  // Tabla de comunas a ancho completo: entran las 15 comunas de la región
  // sin necesidad de recortar ninguna. Si no alcanza el espacio para el
  // título + la tabla completa en la página actual, se pasa a una hoja
  // nueva para que ambos queden juntos (nunca el título solo).
  const pageHLandscape = 215.9;
  if (y > pageHLandscape - 110) { doc.addPage(); y = 15; }
  agregarResumenComunaTabla(doc, marginX, y, contentW, 'Resumen por comuna: Elegible, Observado Programa, Observado URS, En Revisión URS, En Evaluación Técnica');
  y = doc.lastAutoTable.finalY + 10;

  // Tabla PMB Tradicional / Tradicional, año de postulación 2026, por comuna y estado.
  agregarTablaTradicional2026PDF(doc, marginX, y, contentW);
  y = doc.lastAutoTable.finalY + 10;

  // Listado detallado: proyectos "En Revisión URS" por profesional.
  y = agregarListadoRevisionPorProfesional(doc, marginX, y, contentW);

  // Listado detallado: proyectos del evento "Transferencia Gobierno Regional
  // 2026", ordenados por estado.
  y = agregarListadoPorEvento(doc, marginX, y, contentW, 'Ficha Simplificada SUBDERE Catastrofe 2026');
  agregarListadoPorEvento(doc, marginX, y, contentW, 'Transferencia Gobierno Regional 2026');

  doc.save(`informe_resumen_subdere_${new Date().toISOString().slice(0,10)}.pdf`);
}

function agregarListadoRevisionPorProfesional(doc, x, y, maxW) {
  const pageH = 215.9;
  if (y > pageH - 30) { doc.addPage(); y = 15; }

  doc.setFontSize(10);
  doc.setTextColor(35, 49, 108);
  doc.text('Listado detallado: Proyectos "En Revisión URS" (ordenado por días en revisión)', x, y);
  y += 5;

  // Colores de urgencia dibujados como círculo vectorial (no emoji, para que
  // siempre se vean bien sin depender de si la fuente del PDF los soporta).
  const FONT_SIZE_TABLA = 6.8;
  const RADIO_CIRCULO = (FONT_SIZE_TABLA * 0.3528) / 2; // pt -> mm, mismo alto que el texto
  const colorUrgencia = (dias) => {
    if (dias == null || isNaN(dias)) return null;
    if (dias > 20) return [201, 87, 107];   // rojo
    if (dias >= 11) return [230, 181, 46];  // amarillo
    return null;
  };

  const proyectosRevision = filtered
    .filter(d => d.estado === 'En Revisión URS')
    .map(d => ({ ...d, profesional: d.profesional && d.profesional.trim() !== '' ? d.profesional : 'Sin asignar' }))
    .sort((a, b) => (Number(b.dias_en_estado) || 0) - (Number(a.dias_en_estado) || 0));

  if (proyectosRevision.length === 0) {
    doc.setFontSize(8);
    doc.setTextColor(120, 120, 120);
    doc.text('(sin proyectos en este estado en la vista actual)', x, y + 4);
    return y + 10;
  }

  doc.autoTable({
    startY: y,
    margin: { left: x },
    tableWidth: maxW,
    head: [['Días', '', 'Profesional', 'ID', 'Proyecto', 'Comuna', 'Programa']],
    body: proyectosRevision.map(d => [
      d.dias_en_estado ?? '',
      '', // el círculo se dibuja aparte en didDrawCell, no como texto
      d.profesional, d.id_proyecto ?? '', d.nombre_proyecto ?? '', d.comuna ?? '', d.programa ?? '',
    ]),
    styles: { fontSize: FONT_SIZE_TABLA, cellPadding: 1.3 },
    columnStyles: {
      0: { halign: 'center', cellWidth: 12 },
      1: { halign: 'center', cellWidth: 8 },
      4: { cellWidth: maxW * 0.30 },
    },
    headStyles: { fillColor: [201, 87, 107], fontSize: FONT_SIZE_TABLA },
    didDrawCell: (data) => {
      if (data.section === 'body' && data.column.index === 1) {
        const color = colorUrgencia(Number(data.row.raw[0]));
        if (color) {
          const cx = data.cell.x + data.cell.width / 2;
          const cy = data.cell.y + data.cell.height / 2;
          doc.setFillColor(color[0], color[1], color[2]);
          doc.circle(cx, cy, RADIO_CIRCULO, 'F');
        }
      }
    },
  });

  return doc.lastAutoTable.finalY + 10;
}

function agregarListadoPorEvento(doc, x, y, maxW, nombreEvento) {
  const pageH = 215.9;
  if (y > pageH - 30) { doc.addPage(); y = 15; }

  doc.setFontSize(10);
  doc.setTextColor(35, 49, 108);
  doc.text(`Listado detallado: Proyectos "${nombreEvento}" (por estado)`, x, y);
  y += 5;

  const proyectosEvento = filtered
    .filter(d => d.evento === nombreEvento)
    .sort((a, b) => a.estado.localeCompare(b.estado) || a.comuna.localeCompare(b.comuna));

  if (proyectosEvento.length === 0) {
    doc.setFontSize(8);
    doc.setTextColor(120, 120, 120);
    doc.text('(sin proyectos de este evento en la vista actual)', x, y + 4);
    return y + 10;
  }

  doc.autoTable({
    startY: y,
    margin: { left: x },
    tableWidth: maxW,
    head: [['Estado', 'ID', 'Proyecto', 'Comuna', 'Programa']],
    body: proyectosEvento.map(d => [d.estado ?? '', d.id_proyecto ?? '', d.nombre_proyecto ?? '', d.comuna ?? '', d.programa ?? '']),
    styles: { fontSize: 6.8, cellPadding: 1.3 },
    columnStyles: { 2: { cellWidth: maxW * 0.35 } },
    headStyles: { fillColor: [35, 49, 108], fontSize: 6.8 },
    didParseCell: (() => {
      let estadoAnterior = null;
      return (data) => {
        if (data.section === 'body' && data.column.index === 0) {
          const estadoActual = data.row.raw[0];
          if (estadoActual !== estadoAnterior) {
            data.cell.styles.fontStyle = 'bold';
            estadoAnterior = estadoActual;
          } else {
            data.cell.text = [''];
          }
        }
      };
    })(),
  });
  return doc.lastAutoTable.finalY + 10;
}

function agregarTablaTradicional2026PDF(doc, x, y, maxW) {
  const pageH = 215.9;
  if (y > pageH - 30) { doc.addPage(); y = 15; }

  doc.setFontSize(9);
  doc.setTextColor(70, 70, 70);
  const titulo = 'PMB Tradicional y PMU Tradicional / Año 2026 (por comuna y estado)';
  const tituloLineas = doc.splitTextToSize(titulo, maxW);
  doc.text(tituloLineas, x, y);
  const yTabla = y + (tituloLineas.length - 1) * 4 + 2;

  const PROGRAMAS_TRAD = ['PMB Tradicional', 'Tradicional'];
  const proyectosTrad2026 = filtered.filter(d =>
    PROGRAMAS_TRAD.includes(d.programa) && String(d.anio_postulacion) === '2026'
  );
  const estadosTrad = unique(proyectosTrad2026, 'estado');

  if (estadosTrad.length === 0) {
    doc.setFontSize(8);
    doc.text('(sin proyectos PMB Tradicional / Tradicional con año de postulación 2026 en la vista actual)', x, yTabla + 4);
    return;
  }

  const COLOR_PROGRAMA_PDF = { 'PMB Tradicional': [91,141,255], 'Tradicional': [230,159,0] };
  const tintClaro = (c) => c.map(v => Math.round(v + (255 - v) * 0.8)); // versión pastel para celdas de cuerpo
  const tintMedio = (c) => c.map(v => Math.round(v + (255 - v) * 0.55)); // versión intermedia para sub-encabezado

  const head1 = [{ content: 'Comuna', rowSpan: 2 }].concat(
    PROGRAMAS_TRAD.map(p => ({
      content: p, colSpan: estadosTrad.length,
      styles: { halign: 'center', fillColor: COLOR_PROGRAMA_PDF[p] || [140,140,140], textColor: [255,255,255] },
    }))
  );
  const head2 = PROGRAMAS_TRAD.flatMap(p => estadosTrad.map(e => ({
    content: abreviarEstado(e),
    styles: { fillColor: tintMedio(COLOR_PROGRAMA_PDF[p] || [140,140,140]), textColor: [40,40,40] },
  })));

  const body = TODAS_LAS_COMUNAS.map(comuna => {
    const celdas = PROGRAMAS_TRAD.flatMap(programa =>
      estadosTrad.map(estado =>
        proyectosTrad2026.filter(d => d.comuna === comuna && d.programa === programa && d.estado === estado).length || '—'
      )
    );
    return [comuna, ...celdas];
  });

  // Estilos de columna: una tinta pastel por cada bloque de programa.
  const columnStylesTrad = {};
  let colIdx = 1;
  PROGRAMAS_TRAD.forEach(p => {
    const color = tintClaro(COLOR_PROGRAMA_PDF[p] || [140,140,140]);
    for (let i = 0; i < estadosTrad.length; i++) {
      columnStylesTrad[colIdx] = { fillColor: color };
      colIdx++;
    }
  });

  doc.autoTable({
    startY: yTabla,
    margin: { left: x },
    tableWidth: maxW,
    head: [head1, head2],
    body,
    styles: { fontSize: 6.3, cellPadding: 1, halign: 'center' },
    columnStyles: Object.assign({ 0: { halign: 'left', fontStyle: 'bold' } }, columnStylesTrad),
    headStyles: { fillColor: [35, 49, 108], fontSize: 6.3 },
  });
}

function descargarResumenXLS() {
  // Mismas filas que ve la tabla en pantalla y que usa el PDF de esta
  // pestaña (respeta filtros generales + buscador de Tabla dinámica).
  const filasDatos = filteredTablaRows();
  const montoTotal = filasDatos.reduce((s, d) => s + (d.monto_subdere || 0), 0);

  const wb = XLSX.utils.book_new();

  // ---- Hoja 1: Resumen ----
  const wsResumen = XLSX.utils.aoa_to_sheet([
    ['SUBDERE en Línea — Resumen de Proyectos (Región de Coquimbo)'],
    [`Generado el ${new Date().toLocaleDateString('es-CL')}`],
    [],
    ['Filtros aplicados', resumenFiltrosActivos()],
    [],
    ['Total proyectos', filasDatos.length],
    ['Aporte SUBDERE total', montoTotal],
    ['Comunas', new Set(filasDatos.map(d => d.comuna)).size],
  ]);
  wsResumen['!cols'] = [{ wch: 35 }, { wch: 45 }];
  XLSX.utils.book_append_sheet(wb, wsResumen, 'Resumen');

  // ---- Hoja 2: Proyectos (mismas columnas que la tabla/PDF de esta pestaña) ----
  const wsProyectos = XLSX.utils.aoa_to_sheet([
    ['ID', 'Proyecto', 'Comuna', 'Programa', 'Estado', 'Días en Estado', 'Evento', 'Profesional', 'Año Aprob.', 'Aporte ($)'],
    ...filasDatos.map(d => [
      d.id_proyecto ?? '', d.nombre_proyecto ?? '', d.comuna ?? '', d.programa ?? '',
      d.estado ?? '', d.dias_en_estado ?? '', d.evento ?? '', d.profesional ?? '', d.anio_aprobacion ?? '', d.monto_subdere || 0,
    ]),
  ]);
  wsProyectos['!cols'] = [
    { wch: 16 }, { wch: 55 }, { wch: 16 }, { wch: 35 }, { wch: 25 },
    { wch: 14 }, { wch: 35 }, { wch: 20 }, { wch: 11 }, { wch: 16 },
  ];
  XLSX.utils.book_append_sheet(wb, wsProyectos, 'Proyectos');

  XLSX.writeFile(wb, `resumen_proyectos_subdere_${new Date().toISOString().slice(0,10)}.xlsx`);
}

function descargarResumenPDF() {
  const { jsPDF } = window.jspdf;

  // Usamos exactamente el mismo conjunto de filas que se ve en la tabla en
  // pantalla (respeta los filtros generales Y el buscador de esta pestaña),
  // para que el resumen y el listado del PDF siempre coincidan.
  const filasDatos = filteredTablaRows();

  const logoImg = new Image();
  logoImg.onload = function () {
    generarPDFConLogo(jsPDF, filasDatos, logoImg.naturalWidth, logoImg.naturalHeight);
  };
  logoImg.onerror = function () {
    generarPDFConLogo(jsPDF, filasDatos, null, null); // continúa sin logo si falla la carga
  };
  logoImg.src = `data:image/jpeg;base64,${LOGO_BASE64}`;
}

function generarPDFConLogo(jsPDF, filasDatos, logoW, logoH) {
  const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'letter' });
  doc.setFont('helvetica', 'normal');
  const pageW = 279.4;
  const marginX = 12;

  let textoX = marginX;
  if (logoW && logoH) {
    // Mantiene la proporción real del logo, con una altura fija razonable
    const alturaLogo = 14;
    const anchoLogo = alturaLogo * (logoW / logoH);
    doc.addImage(`data:image/jpeg;base64,${LOGO_BASE64}`, 'JPEG', marginX, 8, anchoLogo, alturaLogo);
    textoX = marginX + anchoLogo + 6;
  }

  doc.setFont(undefined, 'bold');
  doc.setFontSize(13);
  doc.setTextColor(35, 49, 108);
  doc.text('SUBDERE en Línea', textoX, 13);
  doc.setFontSize(10.5);
  doc.setTextColor(70, 80, 120);
  doc.text('Resumen de Proyectos — Región de Coquimbo', textoX, 19);
  doc.setFont(undefined, 'normal');

  doc.setFontSize(8.5);
  doc.setTextColor(110, 110, 110);
  doc.text(`Generado el ${new Date().toLocaleDateString('es-CL')} · ${filasDatos.length.toLocaleString('es-CL')} proyectos en este listado`, textoX, 24.5);

  let y = 30;
  doc.setFontSize(8.5);
  doc.setTextColor(90, 90, 90);
  const filtrosTexto = doc.splitTextToSize(`Filtros aplicados: ${resumenFiltrosActivos()}`, pageW - marginX * 2);
  doc.text(filtrosTexto, marginX, y);
  y += filtrosTexto.length * 4 + 3;

  const montoTotal = filasDatos.reduce((s, d) => s + (d.monto_subdere || 0), 0);
  doc.setFontSize(10);
  doc.setTextColor(20, 20, 20);
  doc.text(`Total proyectos: ${filasDatos.length.toLocaleString('es-CL')}    |    Aporte SUBDERE total: ${fmtCLP(montoTotal)}    |    Comunas: ${new Set(filasDatos.map(d => d.comuna)).size}`, marginX, y);
  y += 4;

  const filas = filasDatos.map(d => [
    d.id_proyecto ?? '', d.nombre_proyecto ?? '', d.comuna ?? '', d.programa ?? '',
    d.estado ?? '', d.dias_en_estado ?? '', d.evento ?? '', d.profesional ?? '', d.anio_aprobacion ?? '', fmtCLP(d.monto_subdere || 0),
  ]);

  doc.autoTable({
    startY: y + 3,
    head: [['ID', 'Proyecto', 'Comuna', 'Programa', 'Estado', 'Días en Estado', 'Evento', 'Profesional', 'Año Aprob.', 'Aporte ($)']],
    body: filas,
    styles: { fontSize: 7, cellPadding: 1.5 },
    headStyles: { fillColor: [35, 49, 108] },
    columnStyles: { 1: { cellWidth: 70 } },
    margin: { left: 12, right: 12 },
  });

  doc.save(`resumen_proyectos_subdere_${new Date().toISOString().slice(0,10)}.pdf`);
}
