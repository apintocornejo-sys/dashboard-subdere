  if (RF.filtros.programa.size) { const ok = new Set(base.filter(p => RF.filtros.programa.has(p.programa)).map(p => p.subprograma)); [...RF.filtros.subprograma].forEach(v => { if (!ok.has(v)) RF.filtros.subprograma.delete(v); }); }
}
