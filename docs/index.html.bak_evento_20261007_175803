async function driveFetch(url, options = {}) {
  options.headers = Object.assign({}, options.headers, { Authorization: `Bearer ${oauthToken}` });
  const r = await fetch(url, options);
  if (!r.ok) throw new Error(`Drive API error ${r.status}: ${await r.text()}`);
  return r;
}

// Usa siempre el mismo ID fijo (DATOS_EXTRA_FILE_ID) — nunca busca por
// nombre ni crea archivos nuevos. Esto evita el bug anterior donde una
// búsqueda que no encontraba el archivo a tiempo terminaba creando uno
// nuevo vacío, "perdiendo" los datos ya guardados.
async function cargarDatosExtraParaEditar() {
  if (DATOS_EXTRA_FILE_ID.startsWith('PEGA_AQUI')) {
    alert('Falta configurar DATOS_EXTRA_FILE_ID en el código. Ver README.');
    return;
  }
  const contentRes = await driveFetch(`https://www.googleapis.com/drive/v3/files/${DATOS_EXTRA_FILE_ID}?alt=media`);
  datosExtra = await contentRes.json();
  rfRefrescarExtra();
}

async function guardarEnDrive() {
  await driveFetch(`https://www.googleapis.com/upload/drive/v3/files/${DATOS_EXTRA_FILE_ID}?uploadType=media`, {
