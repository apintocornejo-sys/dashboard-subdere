function filteredTablaRows() {
  const q = document.getElementById('tabla-search').value.trim().toLowerCase();
  let rows = filtered;
  if (q) rows = rows.filter(d =>
    String(d.nombre_proyecto||'').toLowerCase().includes(q) ||
    String(d.comuna||'').toLowerCase().includes(q) ||
    String(d.id_proyecto||'').toLowerCase().includes(q));
  rows = [...rows].sort((a,b) => {
    const av=a[tablaSort.col], bv=b[tablaSort.col];
    if (av===null||av===undefined) return 1;
    if (bv===null||bv===undefined) return -1;
    if (typeof av === 'number') return (av-bv)*tablaSort.dir;
    return String(av).localeCompare(String(bv)) * tablaSort.dir;
  });
  return rows;
}

function renderTabla() {
