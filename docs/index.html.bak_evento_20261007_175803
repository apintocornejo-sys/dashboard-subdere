function renderResumen() {
  renderProfesionalRevision();
  renderIndicadoresModoReunion();

  // Distribución por estado: barra horizontal — la mejor opción cuando hay
  // muchas categorías con nombres largos (evita rotar/truncar etiquetas y
  // permite comparar magnitudes con precisión, sin la distorsión de un radar).
  const porEstado = groupBy(filtered,'estado').sort((a,b)=>b.n-a.n).slice(0,12);
  makeChart('chartEstado','bar', porEstado.map(d=>d.key), [{
    data: porEstado.map(d=>d.n), backgroundColor: palette[0], borderRadius:4,
  }], { indexAxis:'y', drilldownCampo: 'estado' });

  // Distribución por programa: dona — pocas categorías (top 8), útil para
  // comunicar "parte de un todo" de un vistazo.
  const porPrograma = groupBy(filtered,'programa').sort((a,b)=>b.n-a.n).slice(0,8);
  makeChart('chartProgramaDonut','doughnut', porPrograma.map(d=>d.key), [{ data:porPrograma.map(d=>d.n), backgroundColor:palette.concat(['#A67C52','#7F8F9A']) }], { drilldownCampo: 'programa' });

  // Aporte por provincia: solo 3 categorías — barra vertical simple y clara.
  const porProvincia = groupBy(filtered,'provincia').sort((a,b)=>b.monto-a.monto);
  makeChart('chartAportePorProvincia','bar', porProvincia.map(d=>d.key), [{ data:porProvincia.map(d=>d.monto), backgroundColor:palette[2], borderRadius:4 }], {
    plugins: { datalabels: { formatter: (v) => fmtCLP(v) } },
    drilldownCampo: 'provincia',
  });

  // PMB Tradicional / Tradicional, Año Postulación 2026: tabla con las 15
  // comunas de la región (fila), columnas agrupadas por programa y, dentro
  // de cada una, desglosadas por estado.
  renderTablaTradicional2026();

  // Distribución por evento, separado por estado: gráfico de COLUMNAS
  // (barras verticales) apiladas por estado dentro de cada evento.
  const proyectosConEvento = filtered.filter(d => d.evento && d.evento.trim() !== '');
  const eventosOrdenados = groupBy(proyectosConEvento, 'evento').sort((a,b)=>b.n-a.n).map(d=>d.key);
  if (eventosOrdenados.length > 0) {
    const estadosEvento = unique(proyectosConEvento, 'estado');
    const datasetsEvento = estadosEvento.map((estado, i) => ({
      label: estado,
      backgroundColor: palette[i % palette.length],
      data: eventosOrdenados.map(evento => proyectosConEvento.filter(d => d.evento === evento && d.estado === estado).length),
    }));
    makeChart('chartEvento', 'bar', eventosOrdenados, datasetsEvento, {
      indexAxis: 'y',
      scales: {
        x: { stacked: true, grid: { color: '#4f3f33' }, beginAtZero: true },
        y: { stacked: true, grid: { display: false } },
      },
      plugins: {
        legend: { display: true, position: 'bottom' },
        datalabels: { anchor: 'center', align: 'center', color: '#2F2620', font: { size: 8, weight: '700' }, formatter: (v) => v > 0 ? v : '' },
      },
      onClick: (evt, elements) => {
        if (!elements.length) return;
        const el = elements[0];
        multiselectState['f-evento-filtro'].clear();
        multiselectState['f-evento-filtro'].add(eventosOrdenados[el.index]);
        multiselectState['f-estado'].clear();
        multiselectState['f-estado'].add(estadosEvento[el.datasetIndex]);
        refreshFilterOptions();
        applyFilters();
        const buscadorTabla = document.getElementById('tabla-search');
        if (buscadorTabla) buscadorTabla.value = '';
        const tabTabla = document.querySelector('.tab[data-view="tabla"]');
        if (tabTabla) tabTabla.click();
      },
    });
  } else if (charts['chartEvento']) {
    charts['chartEvento'].destroy();
    delete charts['chartEvento'];
  }

  // Resumen por comuna x estado: barra horizontal APILADA. Es la forma más
  // clara de comparar 4 categorías a la vez a través de muchas comunas: cada
  // fila es una comuna, el largo total y cada segmento se leen con precisión,
  // sin la ambigüedad visual de una vista 3D en perspectiva.
  const ESTADOS_CLAVE = ['Elegible', 'Observado Programa', 'Observado URS', 'En Revisión URS', 'En Evaluación Técnica'];
  const coloresEstadosClave = [palette[0], palette[2], palette[1], palette[5], palette[3]];
  const comunasConDatos = unique(filtered.filter(d => ESTADOS_CLAVE.includes(d.estado)), 'comuna');
  const totalesPorComuna = comunasConDatos.map(c => ({
    comuna: c,
    total: ESTADOS_CLAVE.reduce((s,e) => s + filtered.filter(d => d.comuna===c && d.estado===e).length, 0),
  })).sort((a,b) => b.total - a.total);
  const comunasOrdenadas = totalesPorComuna.map(d => d.comuna);

  const datasetsEstadosClave = ESTADOS_CLAVE.map((estado, i) => ({
    label: estado,
    backgroundColor: coloresEstadosClave[i],
    data: comunasOrdenadas.map(comuna => filtered.filter(d => d.comuna === comuna && d.estado === estado).length),
  }));
  makeChart('chartComunaEstadosClave', 'bar', comunasOrdenadas, datasetsEstadosClave, {
    indexAxis: 'y',
    scales: {
      x: { stacked: true, grid: { color: '#4f3f33' }, beginAtZero: true },
      y: { stacked: true, grid: { display: false } },
    },
    plugins: {
      legend: { display: true, position: 'bottom' },
      datalabels: { anchor: 'center', align: 'center', color: '#2F2620', font: { size: 9, weight: '700' }, formatter: (v) => v > 0 ? v : '' },
    },
  });
}

