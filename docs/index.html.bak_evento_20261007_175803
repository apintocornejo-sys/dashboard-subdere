  // Detalle de proyectos
  y = doc.lastAutoTable.finalY + 10;
  if (y > pageH - 40) { doc.addPage(); y = 14; }
  doc.setFontSize(10);
  doc.setTextColor(35, 49, 108);
  doc.setFont(undefined, 'bold');
  doc.text('Detalle de proyectos del evento', marginX, y);
  doc.setFont(undefined, 'normal');

  const ordenComuna = Object.fromEntries(ASIGNACION_GR_2026.map(([c], i) => [c, i]));
  const detalle = [...proyectos].sort((a, b) =>
    (ordenComuna[a.comuna] - ordenComuna[b.comuna]) || ((b.monto_subdere || 0) - (a.monto_subdere || 0)));
