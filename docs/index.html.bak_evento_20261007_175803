  const fechas = (titulo, k, ok) => `<div class="rf-campo doble"><label>${titulo}</label><div class="rf-fechas"${ok ? '' : ' title="El informe no trae esta fecha"'}>
      <input type="date" value="${RF.filtros[k + 'Desde']}" onchange="rfFechaFiltro('${k}Desde', this.value)"${ok ? '' : ' disabled'} aria-label="${titulo} desde">
      <input type="date" value="${RF.filtros[k + 'Hasta']}" onchange="rfFechaFiltro('${k}Hasta', this.value)"${ok ? '' : ' disabled'} aria-label="${titulo} hasta"></div></div>`;
  const seg = `<div class="rf-campo"><label>Seguimiento URS</label><label class="rf-check"${disp.seguimiento ? '' : ' title="Aún no hay Estado Real cargado en Datos adicionales"'}><input type="checkbox"${RF.filtros.soloSeg ? ' checked' : ''}${disp.seguimiento ? '' : ' disabled'} onchange="rfSoloSeg(this.checked)"> Solo proyectos con Estado Real</label></div>`;
  document.getElementById('rf-filtros-grid').innerHTML = campos + fechas('Fecha Asignación (desde / hasta)', 'asig', disp.fecha_asignacion) + fechas('Fecha de Término (desde / hasta)', 'ter', disp.fecha_termino) +
    fechas('Fecha Vencimiento Boleta de Garantía (desde / hasta)', 'venc', disp.garantia) + seg;
}
function rfMsAbrir(id, ev) {
