  const detalle = [...f].sort((a, b) => String(a.comuna).localeCompare(String(b.comuna), 'es') || rfNum(b.saldo_por_rendir) - rfNum(a.saldo_por_rendir));
  const wsD = XLSX.utils.aoa_to_sheet([
