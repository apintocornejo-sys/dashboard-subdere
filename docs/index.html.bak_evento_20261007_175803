}

// ---------- Alerta de plazos ----------
function rfRenderAlertas(f, disp, hoy, lim) {
  const el = document.getElementById('rf-alertas');
  if (!disp.fecha_termino) { el.innerHTML = '<h2>⏰ Plazos de ejecución</h2><p style="color:var(--ink-dim);font-size:0.85rem;margin:6px 0 0">El informe no trae fechas de término ni una fecha desde la cual calcularlas, por eso no hay alertas de plazo.</p>'; return; }
  const venc = [], porv = [];
  f.forEach(p => { const e = rfEstadoPlazo(p, hoy, lim, disp); if (e === 'vencido') venc.push(p); else if (e === 'porvencer') porv.push(p); });
  venc.sort((a, b) => rfNum(b.saldo_por_rendir) - rfNum(a.saldo_por_rendir) || a.fecha_termino.localeCompare(b.fecha_termino));
  porv.sort((a, b) => a.fecha_termino.localeCompare(b.fecha_termino));
  const saldoVenc = venc.reduce((s, p) => s + rfNum(p.saldo_por_rendir), 0);
  const lim_ = RF.verMas ? 25 : 6;
  const fila = (p, tipo) => {
    const d = rfDias(p.fecha_termino, hoy);
    const cuando = tipo === 'vencido' ? `hace ${d} día${d === 1 ? '' : 's'}` : (d === 0 ? 'hoy' : `en ${-d} día${d === -1 ? '' : 's'}`);
    return `<tr><td>${rfEsc(p.comuna || '—')}</td><td title="${rfEsc(p.nombre || '')}">${rfEsc((p.nombre || p.id_proyecto || '').slice(0, 70))}${(p.nombre || '').length > 70 ? '…' : ''}<div style="font-size:0.66rem;color:var(--ink-dim)">${rfEsc(p.id_proyecto || '')}</div></td>
      <td class="num">${rfFecha(p.fecha_termino)}${p.termino_estimado ? ' (est.)' : ''}<div style="font-size:0.66rem;color:var(--ink-dim)">${cuando}</div></td>
      <td class="num">${disp.saldo_por_rendir && p.saldo_por_rendir != null ? fmtCLPn(p.saldo_por_rendir) : '—'}</td></tr>`;
  };
  const tabla = (lista, tipo) => lista.length ? `<div style="overflow-x:auto"><table class="rf-mini"><thead><tr><th>Comuna</th><th>Proyecto</th><th class="num">Término</th><th class="num">Saldo por rendir</th></tr></thead><tbody>${lista.slice(0, lim_).map(p => fila(p, tipo)).join('')}</tbody></table></div>` : '';
  el.innerHTML = `<h2>⏰ Plazos de ejecución</h2>
    <div class="rf-alerta-cab">
      <div class="rf-alerta-caja roja"><div class="cifra">${venc.length.toLocaleString('es-CL')}</div><div class="txt"><b>Plazo vencido</b> con saldo por rendir${disp.saldo_por_rendir ? ` · ${fmtCLPn(saldoVenc)} pendientes` : ''}</div>
        ${venc.length ? `<button class="btn btn-ghost" style="margin-top:8px;padding:4px 12px;font-size:0.72rem" onclick="rfVerAlerta('vencido')">Ver en la tabla</button>` : ''}</div>
      <div class="rf-alerta-caja ocre"><div class="cifra">${porv.length.toLocaleString('es-CL')}</div><div class="txt"><b>Vence en los próximos 30 días</b></div>
        ${porv.length ? `<button class="btn btn-ghost" style="margin-top:8px;padding:4px 12px;font-size:0.72rem" onclick="rfVerAlerta('porvencer')">Ver en la tabla</button>` : ''}</div>
    </div>
    ${venc.length ? `<h3 style="margin:10px 0 4px;font-size:0.82rem;color:#FF9C7A">Plazo vencido (mayor saldo por rendir primero)</h3>${tabla(venc, 'vencido')}` : ''}
    ${porv.length ? `<h3 style="margin:12px 0 4px;font-size:0.82rem;color:#F2C14E">Por vencer (más próximos primero)</h3>${tabla(porv, 'porvencer')}` : ''}
    ${(venc.length > 6 || porv.length > 6) ? `<button class="btn btn-ghost" style="margin-top:10px;padding:4px 14px;font-size:0.74rem" onclick="RF.verMas = !RF.verMas; renderRendiciones()">${RF.verMas ? 'Mostrar menos' : 'Mostrar más'}</button>` : ''}
    ${(!venc.length && !porv.length) ? '<p style="color:var(--ink-dim);font-size:0.85rem;margin:4px 0 0">Ningún proyecto con plazo vencido o por vencer con los filtros actuales. ✅</p>' : ''}`;
}
function rfVerAlerta(tipo) {
  RF.alerta = tipo; RF.pagina = 0; renderRendiciones();
  const t = document.getElementById('tbl-rf'); if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
