  agregarImagenChart(doc, 'chartRfPrograma', mx, 14, 124, 175, `Por programa — ${nombreMetrica}`);
  agregarImagenChart(doc, 'chartRfProvincia', mx + 134, 14, 117, 80, `Por provincia — ${nombreMetrica}`);
  agregarImagenChart(doc, 'chartRfAnio', mx + 134, 104, 117, 85, `Evolución anual — ${nombreMetrica}`);
  doc.addPage();
  agregarImagenChart(doc, 'chartRfComuna', mx, 14, 150, 185, `Por comuna — ${nombreMetrica}`);

  // Tablas
  doc.addPage(); titulo('Resumen por programa', 14); tablaAgg(17, 'Programa', rfAgregar(f, 'programa').sort((a, b) => b.saldoRendir - a.saldoRendir || b.asignado - a.asignado), false);
  let y2 = doc.lastAutoTable.finalY + 10; if (y2 > pageH - 50) { doc.addPage(); y2 = 14; }
  titulo('Resumen por comuna', y2); tablaAgg(y2 + 3, 'Comuna', rfAgregar(f, 'comuna').sort((a, b) => b.saldoRendir - a.saldoRendir || b.asignado - a.asignado), false);

  // Alertas de plazo
  if (disp.fecha_termino && (pl.venc.length || pl.porv.length)) {
    doc.addPage(); titulo(`Plazos de ejecución — ${pl.venc.length} con plazo vencido y saldo por rendir · ${pl.porv.length} vencen en los próximos 30 días`, 14);
    let ya = 17;
    [['Plazo vencido (mayor saldo por rendir primero)', pl.venc, [190, 40, 60]], ['Vence en los próximos 30 días', pl.porv, [217, 164, 65]]].forEach(([t, lista, col]) => {
      if (!lista.length) return;
      if (ya > pageH - 40) { doc.addPage(); ya = 14; }
      doc.setFontSize(9); doc.setTextColor(col[0], col[1], col[2]); doc.setFont(undefined, 'bold'); doc.text(`${t} (${lista.length}${lista.length > 80 ? ', primeros 80' : ''})`, mx, ya + 3); doc.setFont(undefined, 'normal');
      doc.autoTable({ startY: ya + 5, margin: { left: mx, right: mx }, head: [['Comuna', 'Id. Proyecto', 'Nombre', 'Término', 'Saldo por Rendir ($)']],
        body: lista.slice(0, 80).map(p => [p.comuna ?? '', p.id_proyecto ?? '', p.nombre ?? '', rfFecha(p.fecha_termino) + (p.termino_estimado ? ' (est.)' : ''), p.saldo_por_rendir != null ? fmtCLPn(p.saldo_por_rendir) : '—']),
        styles: { fontSize: 7, cellPadding: 1.2 }, columnStyles: { 2: { cellWidth: cw * 0.45 }, 4: { halign: 'right' } }, headStyles: azul, rowPageBreak: 'avoid' });
      ya = doc.lastAutoTable.finalY + 8;
    });
  }

  // Boletas de garantía
  if (disp.garantia) {
    const g = rfClasificarGarantias(f);
    if (g.venc.length || g.p30.length || g.p60.length) {
      doc.addPage(); titulo(`Boletas de garantía — ${g.venc.length} vencidas · ${g.p30.length} vencen en 30 días · ${g.p60.length} entre 31 y 60 días (sin proyectos cerrados ni dejados sin efecto)`, 14);
      let yg = 17;
      [['Boleta vencida (más reciente primero)', g.venc, [190, 40, 60]], ['Vence en los próximos 30 días', g.p30, [217, 164, 65]], ['Vence entre 31 y 60 días', g.p60, [143, 163, 126]]].forEach(([t, lista, col]) => {
