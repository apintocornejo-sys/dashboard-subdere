        doc.autoTable({ startY: yg + 5, margin: { left: mx, right: mx }, head: [['Comuna', 'Id. Proyecto', 'Nombre', 'Estado Real', 'Vence']],
          body: lista.slice(0, 60).map(p => [p.comuna ?? '', p.id_proyecto ?? '', p.nombre ?? '', p.estado_seg ?? '—', rfFecha(p.venc_garantia)]),
