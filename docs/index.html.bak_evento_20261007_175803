const estadoManual = t => { const el = document.getElementById('v-estado'); if (el) el.textContent = t; };

async function leerManualesDrive() {
  const r = await driveFetch(`https://www.googleapis.com/drive/v3/files/${VISITAS_MANUALES_FILE_ID}?alt=media`);
  const txt = await r.text();
  let obj = {};
  try { obj = txt ? JSON.parse(txt) : {}; } catch (e) { throw new Error('El archivo de registros manuales no tiene un formato válido.'); }
  if (!Array.isArray(obj.entradas)) obj.entradas = [];
  return obj;
}
async function escribirManualesDrive(obj) {
  await driveFetch(`https://www.googleapis.com/upload/drive/v3/files/${VISITAS_MANUALES_FILE_ID}?uploadType=media`, {
    method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(obj),
  });
}
async function cargarManualesParaEditar() {
  if (!manualesConfigurado()) return;
  try { VISITAS_MANUALES = await leerManualesDrive(); renderDespliegue(); }
  catch (e) { estadoManual('No se pudieron cargar los registros: ' + e.message); }
}

async function guardarVisitaManual() {
  const fecha = document.getElementById('v-fecha').value, comuna = document.getElementById('v-comuna').value;
  const tipo = document.getElementById('v-tipo').value, online = document.getElementById('v-modalidad').value === 'online';
  const detalle = document.getElementById('v-detalle').value.trim().slice(0, 140);
  if (!manualesConfigurado()) return estadoManual('Falta configurar el archivo de registros manuales.');
  if (!fecha) return estadoManual('Indica la fecha.');
  if (fecha < VISITAS_DESDE) return estadoManual('La fecha debe ser desde el 1 de marzo de 2026.');
  if (fecha > hoyISO()) return estadoManual('Solo se registran actividades ya realizadas (la fecha no puede ser futura).');
  if (!comuna) return estadoManual('Elige la comuna o institución.');
  if (online && tipo !== 'reunion') return estadoManual('Solo una reunión puede ser online.');
  const entrada = { id: 'm' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6), fecha, comuna, tipo, online, detalle,
                    ingresado_por: (sesionActivaVisitas() && usuarioActualEmail) || 'desconocido', ingresado_en: new Date().toISOString() };
  estadoManual('Guardando...');
  try {
    // Se vuelve a leer lo más reciente antes de escribir, para no pisar lo que otra persona haya registrado.
    const actual = await leerManualesDrive();
    actual.entradas.push(entrada);
    await escribirManualesDrive(actual);
    VISITAS_MANUALES = actual;
    limpiarFormularioVisita();
    estadoManual(`Guardado ✓ (${new Date().toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit' })})`);
    renderDespliegue();
  } catch (err) { estadoManual('Error al guardar: ' + err.message); }
}

async function eliminarVisitaManual(id) {
  if (!confirm('¿Eliminar este registro manual?')) return;
  estadoManual('Eliminando...');
  try {
    const actual = await leerManualesDrive();
    actual.entradas = actual.entradas.filter(e => e.id !== id);
    await escribirManualesDrive(actual);
    VISITAS_MANUALES = actual;
    estadoManual('Eliminado ✓'); renderDespliegue();
  } catch (err) { estadoManual('Error al eliminar: ' + err.message); }
}

