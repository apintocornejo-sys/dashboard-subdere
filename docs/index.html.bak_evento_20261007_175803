}

// 'vencido' = término anterior a hoy y aún con saldo por rendir; 'porvencer' = termina dentro de los próximos 30 días
function rfEstadoPlazo(p, hoy, lim, disp) {
  if (!p.fecha_termino) return null;
  if (p.fecha_termino < hoy) return (!disp.saldo_por_rendir || rfNum(p.saldo_por_rendir) > 0) ? 'vencido' : null;
  return p.fecha_termino <= lim ? 'porvencer' : null;
}

function rfFiltrados() {
  const F = RF.filtros;
  const enSet = (set, v) => set.size === 0 || set.has(v);
  const enRango = (v, d, h) => (!d && !h) || (v && (!d || v >= d) && (!h || v <= h));
  return ((RENDICIONES && RENDICIONES.proyectos) || []).filter(p =>
    enSet(F.provincia, p.provincia) && enSet(F.comuna, p.comuna) && enSet(F.programa, p.programa) && enSet(F.subprograma, p.subprograma) &&
    enSet(F.anioAprob, p.anio_aprobacion) && enSet(F.anioPost, p.anio_postulacion) &&
    enRango(p.fecha_asignacion, F.asigDesde, F.asigHasta) && enRango(p.fecha_termino, F.terDesde, F.terHasta) &&
    enRango(p.venc_garantia, F.vencDesde, F.vencHasta) && (!F.soloSeg || !!p.estado_seg));
}

// ---------- Filtros ----------
function rfOpciones(def) {
  let base = (RENDICIONES && RENDICIONES.proyectos) || [];
  if (def.id === 'comuna' && RF.filtros.provincia.size) base = base.filter(p => RF.filtros.provincia.has(p.provincia));
  if (def.id === 'subprograma' && RF.filtros.programa.size) base = base.filter(p => RF.filtros.programa.has(p.programa));
  const vals = [...new Set(base.map(p => p[def.campo]).filter(v => v !== undefined && v !== null && v !== ''))];
  return def.id.startsWith('anio') ? vals.sort((a, b) => b - a) : vals.sort((a, b) => String(a).localeCompare(String(b), 'es'));
}
function rfLimpiarCascada() {   // al cambiar provincia/programa se descartan las comunas/subprogramas que ya no corresponden
  const base = (RENDICIONES && RENDICIONES.proyectos) || [];
