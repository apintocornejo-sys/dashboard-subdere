// ---------- Gráficos ----------
function rfRenderMetricas(disp) {
  if (!disp[RF.metrica]) RF.metrica = RF_METRICAS.find(([k]) => disp[k])?.[0] || 'monto_asignado';
  document.getElementById('rf-chips-metrica').innerHTML = RF_METRICAS.map(([k, t]) =>
    `<span class="chip-filtro rf-chip${RF.metrica === k ? ' activo' : ''}${disp[k] ? '' : ' deshabilitado'}"${disp[k] ? ` onclick="RF.metrica='${k}'; renderRendiciones()"` : ' title="El informe no trae esta columna"'}>${t}</span>`).join('');
}
const RF_FUENTE = { tick: 13, dato: 12, leyenda: 13 };          // pantalla normal
const RF_FUENTE_REU = { tick: 17, dato: 17, leyenda: 17 };      // Modo Reunión (se lee desde lejos)
const RF_TINTA = '#EFE6D6';

function rfPartir(texto, max) {   // parte un nombre largo en líneas de a lo más "max" caracteres (corta en espacios)
  const lineas = []; let actual = '';
  String(texto).split(/\s+/).forEach(p => { if (actual && (actual + ' ' + p).length > max) { lineas.push(actual); actual = p; } else actual = (actual + ' ' + p).trim(); });
  if (actual) lineas.push(actual);
  return lineas.length > 3 ? [lineas[0], lineas[1], (lineas.slice(2).join(' ').slice(0, max - 1) + '…')] : lineas;
}
function rfBarras(id, etiquetas, valores, opts) {   // opts: {horizontal, filtro, extra, scales, leyenda, fuente, fmt, tooltipFmt, color, colores, partir, alto, derecha, rotar, truncar, nombre}
  const F = opts.fuente || RF_FUENTE, fmt = opts.fmt || rfCompacto, tipFmt = opts.tooltipFmt || fmtCLPn;
  const color = opts.color || RF_COLOR[RF.metrica];
  const canvas = document.getElementById(id), caja = canvas.parentElement, partir = opts.partir || 26, rot = opts.rotar || 0;
  // Nombres largos: se parten en líneas, o (si se rotan) se truncan; el nombre completo queda en el tooltip
  const etqMostrar = etiquetas.map(e => {
    if (opts.truncar) return String(e).length > opts.truncar ? String(e).slice(0, opts.truncar - 1) + '…' : String(e);
    const l = rfPartir(e, partir); return l.length === 1 ? l[0] : l;
  });
  const lineas = Math.max(1, ...etqMostrar.map(e => Array.isArray(e) ? e.length : 1));
  // La altura se da al CONTENEDOR del gráfico (Chart.js ajusta el canvas a su contenedor y reescribe el alto del canvas)
  if (opts.horizontal) caja.style.height = Math.max(opts.alto || 280, etiquetas.length * (F.tick * 1.7 + lineas * F.tick * 1.15 + 6) + 60) + 'px';
  else if (opts.alto) caja.style.height = opts.alto + 'px';
  const ejeTexto = { color: RF_TINTA, font: { size: F.tick, weight: '500' } };
  const escalasBase = opts.scales || {
    x: opts.horizontal ? { grid: { color: '#4f3f33' }, ticks: Object.assign({ callback: v => fmt(v), maxRotation: 0, autoSkip: true, maxTicksLimit: 5 }, ejeTexto) }
                       : { grid: { display: false }, ticks: Object.assign({ maxRotation: rot, minRotation: rot, autoSkip: false }, ejeTexto) },
    y: opts.horizontal ? { grid: { display: false }, ticks: Object.assign({ autoSkip: false }, ejeTexto) }
                       : { grid: { color: '#4f3f33' }, beginAtZero: true, ticks: Object.assign({ callback: v => fmt(v) }, ejeTexto) },
  };
  Object.values(escalasBase).forEach(sc => {   // la misma letra grande y clara en todos los ejes
    sc.ticks = Object.assign({}, ejeTexto, sc.ticks || {}); sc.ticks.font = Object.assign({}, ejeTexto.font, (sc.ticks || {}).font);
    if (sc.title) { sc.title.color = RF_TINTA; sc.title.font = { size: F.tick, weight: '600' }; }
  });
  makeChart(id, 'bar', etqMostrar, [{ label: opts.nombre || RF_METRICAS.find(m => m[0] === RF.metrica)[1], data: valores, borderRadius: 4, maxBarThickness: opts.horizontal ? 38 : 70,
      backgroundColor: opts.colores || valores.map(v => v < 0 ? '#C8643C' : color) }].concat(opts.extra || []), {
    indexAxis: opts.horizontal ? 'y' : 'x',
    layout: { padding: { right: opts.horizontal ? (opts.derecha || 100) : 12, top: 30, left: 4 } },
    onClick: opts.filtro ? (evt, els) => { if (els.length && etiquetas[els[0].index] !== 'Otros') rfFiltrarPor(opts.filtro, etiquetas[els[0].index]); } : undefined,
    scales: escalasBase,
    plugins: {
      legend: opts.leyenda ? { display: true, position: 'bottom', labels: { color: RF_TINTA, font: { size: F.leyenda }, padding: 16 } } : { display: false },
      datalabels: { formatter: v => fmt(v), color: '#F5F0E8', backgroundColor: 'rgba(31,25,21,0.85)', borderRadius: 5, padding: { top: 2, bottom: 2, left: 6, right: 6 },
                    font: { size: F.dato, weight: '700' }, anchor: 'end', align: 'end', clip: false },
      tooltip: { titleFont: { size: F.tick + 1 }, bodyFont: { size: F.tick + 1 },
                 callbacks: { title: items => items.length ? String(etiquetas[items[0].dataIndex]) : '', label: c => ' ' + tipFmt(c.parsed[opts.horizontal ? 'x' : 'y']) } },
    },
  });
}
function rfAgrupar(f, campo) {
  const m = new Map();
  f.forEach(p => { const k = p[campo]; if (k === undefined || k === null || k === '') return; m.set(k, (m.get(k) || 0) + rfNum(p[RF.metrica])); });
  return [...m.entries()];
}
function rfRenderGraficos(f, disp) {
  const nombreMetrica = RF_METRICAS.find(m => m[0] === RF.metrica)[1];
  document.getElementById('rf-t-programa').textContent = `Por programa — ${nombreMetrica}`;
  document.getElementById('rf-t-provincia').textContent = `Por provincia — ${nombreMetrica}`;
  document.getElementById('rf-t-comuna').textContent = `Por comuna — ${nombreMetrica}`;

  let prog = rfAgrupar(f, 'programa').sort((a, b) => Math.abs(b[1]) - Math.abs(a[1]));
  if (prog.length > 10) { const resto = prog.slice(10).reduce((s, e) => s + e[1], 0); prog = prog.slice(0, 10).concat([['Otros', resto]]); }
  rfBarras('chartRfPrograma', prog.map(e => e[0]), prog.map(e => e[1]), { horizontal: true, filtro: 'programa' });

  const orden = ['Elqui', 'Limarí', 'Choapa'], pv = new Map(rfAgrupar(f, 'provincia'));
  const provs = orden.filter(p => pv.has(p)).concat([...pv.keys()].filter(p => !orden.includes(p)));
  rfBarras('chartRfProvincia', provs, provs.map(p => pv.get(p)), { filtro: 'provincia' });

  const com = rfAgrupar(f, 'comuna').sort((a, b) => b[1] - a[1]);
  rfBarras('chartRfComuna', com.map(e => e[0]), com.map(e => e[1]), { horizontal: true, filtro: 'comuna' });

  // Evolución por año (aprobación o postulación) + cantidad de proyectos
  const usarAprob = RF.anioDe === 'aprobacion' && disp.anio_aprobacion;
  const campoAnio = usarAprob ? 'anio_aprobacion' : 'anio_postulacion';
  document.getElementById('rf-chips-anio').innerHTML = [['aprobacion', 'Año de aprobación', disp.anio_aprobacion], ['postulacion', 'Año de postulación', true]].map(([k, t, ok]) =>
    `<span class="chip-filtro rf-chip${(usarAprob ? 'aprobacion' : 'postulacion') === k ? ' activo' : ''}${ok ? '' : ' deshabilitado'}"${ok ? ` onclick="RF.anioDe='${k}'; renderRendiciones()"` : ' title="El informe no trae la fecha de asignación"'}>${t}</span>`).join('');
  document.getElementById('rf-t-anio').textContent = `Evolución por ${usarAprob ? 'año de aprobación' : 'año de postulación'} — ${nombreMetrica}`;
  const porAnio = new Map(rfAgrupar(f, campoAnio)), cant = new Map();
  f.forEach(p => { const a = p[campoAnio]; if (a) cant.set(a, (cant.get(a) || 0) + 1); });
  const anios = [...porAnio.keys()].sort((a, b) => a - b);
  rfBarras('chartRfAnio', anios.map(String), anios.map(a => porAnio.get(a)), {
    leyenda: true,
    extra: [{ type: 'line', label: 'N° de proyectos', data: anios.map(a => cant.get(a) || 0), yAxisID: 'y2', borderColor: '#F5F0E8', backgroundColor: '#F5F0E8', borderDash: [5, 4], borderWidth: 2, pointRadius: 3, tension: 0.25,
              datalabels: { align: 'top', anchor: 'end', color: '#F5F0E8', backgroundColor: 'rgba(31,25,21,0.85)', borderRadius: 5, padding: { top: 2, bottom: 2, left: 6, right: 6 }, font: { size: RF_FUENTE.dato, weight: '700' }, formatter: v => v } }],
    scales: { x: { grid: { display: false } }, y: { grid: { color: '#4f3f33' }, beginAtZero: true, ticks: { callback: v => rfCompacto(v) } },
              y2: { position: 'right', beginAtZero: true, grid: { display: false }, title: { display: true, text: 'N° proyectos' }, ticks: { precision: 0 } } },
  });
}

// ---------- Tabla ----------
function rfBuscar(texto) { RF.busqueda = texto; RF.pagina = 0; renderRendiciones(false); }
function rfOrdenar(k) { RF.orden = { k, dir: RF.orden.k === k ? -RF.orden.dir : (RF_COLS.find(c => c.k === k).num ? -1 : 1) }; RF.pagina = 0; renderRendiciones(false); }
function rfPagina(d) { RF.pagina += d; renderRendiciones(false); }
function rfSetAlerta(t) { RF.alerta = t; RF.pagina = 0; renderRendiciones(false); }
function rfRenderTabla(f, disp, hoy, lim) {
  const clase = p => rfEstadoPlazo(p, hoy, lim, disp);
  const nVenc = f.filter(p => clase(p) === 'vencido').length, nPorv = f.filter(p => clase(p) === 'porvencer').length;
  document.getElementById('rf-chips-alerta').innerHTML = [[null, 'Todos', f.length], ['vencido', 'Plazo vencido', nVenc], ['porvencer', 'Vence en 30 días', nPorv]].concat(disp.garantia ? (() => { const gg = rfClasificarGarantias(f); return [['g_venc', 'Garantía vencida', gg.venc.length], ['g_p30', 'Garantía vence en 30 días', gg.p30.length]]; })() : []).map(([k, t, n]) =>
    `<span class="chip-filtro rf-chip${RF.alerta === k ? ' activo' : ''}" onclick="rfSetAlerta(${k ? `'${k}'` : 'null'})">${t}<span class="n">${n.toLocaleString('es-CL')}</span></span>`).join('');
  let filas = RF.alerta ? f.filter(p => rfCoincideAlerta(p, RF.alerta, clase)) : f;
  if (RF.busqueda.trim()) { const q = rfNorm(RF.busqueda.trim()); filas = filas.filter(p => rfNorm([p.id_proyecto, p.nombre, p.comuna, p.programa, p.subprograma].join(' ')).includes(q)); }
  const { k, dir } = RF.orden;
  filas = [...filas].sort((a, b) => {
    const x = a[k], y = b[k];
    if (x == null && y == null) return 0; if (x == null) return 1; if (y == null) return -1;
    return (typeof x === 'number' ? x - y : String(x).localeCompare(String(y), 'es')) * dir;
  });
  const pags = Math.max(1, Math.ceil(filas.length / RF_PAG)); RF.pagina = Math.max(0, Math.min(RF.pagina, pags - 1));
  document.getElementById('rf-thead').innerHTML = RF_COLS.map(c => `<th class="${c.num ? 'num ' : ''}${RF.orden.k === c.k ? 'orden' + (RF.orden.dir < 0 ? ' desc' : '') : ''}" onclick="rfOrdenar('${c.k}')">${c.t}</th>`).join('');
  document.querySelector('#tbl-rf tbody').innerHTML = filas.slice(RF.pagina * RF_PAG, (RF.pagina + 1) * RF_PAG).map(p => {
    const cl = clase(p);
    return `<tr class="${cl === 'vencido' ? 'rf-vencido' : cl === 'porvencer' ? 'rf-porvencer' : ''}">` + RF_COLS.map(c => {
      const v = p[c.k];
