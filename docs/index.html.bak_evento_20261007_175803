const rfHoy = () => { const h = new Date(); return `${h.getFullYear()}-${String(h.getMonth() + 1).padStart(2, '0')}-${String(h.getDate()).padStart(2, '0')}`; };
const rfDias = (a, b) => Math.round((new Date(b + 'T00:00:00') - new Date(a + 'T00:00:00')) / 86400000);
function rfSumarDias(iso, n) { const d = new Date(iso + 'T00:00:00'); d.setDate(d.getDate() + n); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; }

// Qué columnas trajo realmente el informe (para no mostrar ceros inventados)
function rfDisp() {
  const c = RENDICIONES && RENDICIONES.columnas_detectadas;
  const t = k => !c || (k in c);
  return {
    monto_asignado: t('monto_asignado'), monto_contratado: t('monto_contratado'), monto_vigente: t('monto_vigente'),
    saldo_contable: t('monto_asignado') && t('monto_contratado'),
    saldo_por_transferir: t('monto_contratado') && t('total_transferido'),
    saldo_por_rendir: t('saldo_por_rendir') || (t('total_transferido') && t('total_rendido')),
    fecha_asignacion: t('fecha_asignacion'),
    fecha_termino: t('fecha_termino') || t('fecha_inicio') || t('fecha_asignacion'),
    anio_aprobacion: t('fecha_asignacion'),
    // Datos que vienen de "Datos adicionales" (no del informe): existen si al menos un proyecto los tiene
    garantia: ((RENDICIONES && RENDICIONES.proyectos) || []).some(p => p.venc_garantia),
    seguimiento: ((RENDICIONES && RENDICIONES.proyectos) || []).some(p => p.estado_seg),
    avance: ((RENDICIONES && RENDICIONES.proyectos) || []).some(p => p.avance_fisico !== undefined),
