    kpi('Monto Contratado', 'monto_contratado', asig > 0 ? `${(contr / asig * 100).toFixed(1).replace('.', ',')}% del asignado` : '') +
    kpi('Monto Vigente', 'monto_vigente', '') +
    kpi('Saldo Contable', 'saldo_contable', 'Asignado − Contratado') +
