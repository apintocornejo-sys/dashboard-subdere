// ========================================================================
// TRAZABILIDAD: tiempo por lugar (Municipio / Unidad Regional / Nivel Central)
// ========================================================================
const LUGAR_POR_ESTADO = {
  'En Creación Municipal': 'Municipio',
  'Observado URS': 'Municipio',
  'Observado Programa': 'Municipio',
  'En Corrección Municipal': 'Municipio',
  'En Revisión URS': 'Unidad Regional',
  'En Evaluación Técnica': 'Nivel Central',
  'Elegible': 'Apartado a la espera de recursos',
};
const LUGARES = ['Municipio', 'Unidad Regional', 'Nivel Central', 'Apartado a la espera de recursos'];
const FECHA_INICIO_TRAZABILIDAD = '2026-09-29'; // fecha en que empezó a registrarse el historial

function diasPorLugar(idProyecto, estadoActual, diasEnEstadoActual) {
  const totales = { 'Municipio': 0, 'Unidad Regional': 0, 'Nivel Central': 0, 'Apartado a la espera de recursos': 0 };
  const historial = HISTORIAL_ESTADOS[idProyecto];

  if (historial && historial.length > 1) {
    // Tramos ya completados: la duración real es la diferencia de fechas
    // entre un cambio de estado y el siguiente.
    for (let i = 0; i < historial.length - 1; i++) {
      const lugar = LUGAR_POR_ESTADO[historial[i].estado];
      if (!lugar) continue;
      const d1 = new Date(historial[i].fecha);
      const d2 = new Date(historial[i + 1].fecha);
      const dias = Math.round((d2 - d1) / 86400000);
      if (dias > 0) totales[lugar] += dias;
    }
  }

  // Tramo actual (en curso): se usa "Días en Estado", el dato oficial de
  // SUBDERE — es más preciso que calcularlo desde la fecha del último
  // registro de nuestro propio historial.
  const lugarActual = LUGAR_POR_ESTADO[estadoActual];
  if (lugarActual) totales[lugarActual] += Number(diasEnEstadoActual) || 0;

  return totales;
}

function renderTrazabilidad() {
  const fechaInicioEl = document.getElementById('fecha-inicio-trazabilidad');
  if (fechaInicioEl) fechaInicioEl.textContent = FECHA_INICIO_TRAZABILIDAD;

  const sumaTotal = (dias) => LUGARES.reduce((s, lugar) => s + dias[lugar], 0);

  const q = document.getElementById('trazabilidad-search').value.trim().toLowerCase();
  let baseFiltrada = filtered;
  if (q) baseFiltrada = baseFiltrada.filter(d =>
    String(d.nombre_proyecto||'').toLowerCase().includes(q) ||
    String(d.comuna||'').toLowerCase().includes(q) ||
    String(d.id_proyecto||'').toLowerCase().includes(q));

  const filasCalculadas = baseFiltrada
    .map(d => ({ d, dias: diasPorLugar(d.id_proyecto, d.estado, d.dias_en_estado) }))
    .filter(({ dias }) => sumaTotal(dias) > 0);

  // ---- Gráfico: promedio de días por lugar ----
  const promedios = LUGARES.map(lugar => {
    const valores = filasCalculadas.map(f => f.dias[lugar]).filter(v => v > 0);
    return valores.length ? valores.reduce((a, b) => a + b, 0) / valores.length : 0;
  });
  makeChart('chartTrazabilidadPromedio', 'bar', LUGARES, [{
    data: promedios.map(v => Math.round(v * 10) / 10),
    backgroundColor: [palette[0], palette[1], palette[2], palette[3]],
    borderRadius: 4,
  }]);

  // ---- Tabla de detalle ----
  const tbody = document.querySelector('#tbl-trazabilidad tbody');
  if (filasCalculadas.length === 0) {
    tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;color:var(--ink-dim);padding:16px">
      Todavía no hay datos de trazabilidad para la vista actual — se irán acumulando a medida que los proyectos cambien de estado.
    </td></tr>`;
    return;
  }
  tbody.innerHTML = filasCalculadas
    .sort((a, b) => sumaTotal(b.dias) - sumaTotal(a.dias))
    .map(({ d, dias }) => {
      return `<tr>
        <td>${d.id_proyecto ?? ''}</td>
        <td>${d.nombre_proyecto ?? ''}</td>
        <td>${d.comuna ?? ''}</td>
        <td>${d.estado ?? ''}</td>
        <td class="num">${dias['Municipio'] || '—'}</td>
        <td class="num">${dias['Unidad Regional'] || '—'}</td>
        <td class="num">${dias['Nivel Central'] || '—'}</td>
        <td class="num">${dias['Apartado a la espera de recursos'] || '—'}</td>
        <td class="num"><b>${sumaTotal(dias)}</b></td>
      </tr>`;
    }).join('');
}


