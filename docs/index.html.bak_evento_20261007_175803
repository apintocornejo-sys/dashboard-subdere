      datalabels: { font: { size: 8, weight: '600' }, formatter: v => v > 0 ? fmtMillonesGR(v) : '' },
    },
  });

  // ---- Tabla comparativa por comuna ----
  const filaHtml = f => `
    <tr class="fila-clic" onclick="irATablaGR2026('${f.comuna}')" title="Ver los proyectos de ${f.comuna}">
      <td>${f.comuna}</td>
      <td class="num">${fmtCLP(f.asignado)}</td>
