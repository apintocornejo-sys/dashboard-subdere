// ---------- Utilidades ----------
const rfEsc = t => String(t ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const rfNum = v => (typeof v === 'number' && isFinite(v)) ? v : 0;
const rfNorm = t => String(t ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const rfCompacto = n => (n < 0 ? '-' : '') + '$' + Math.round(Math.abs(n) / 1e6).toLocaleString('es-CL') + ' MM';
