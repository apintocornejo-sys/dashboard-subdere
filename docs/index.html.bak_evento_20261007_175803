    headStyles: { fillColor: [35, 49, 108], textColor: [255, 255, 255] },
    rowPageBreak: 'avoid',
  });

  doc.save(`informe_transferencia_gr2026_${new Date().toISOString().slice(0, 10)}.pdf`);
}

