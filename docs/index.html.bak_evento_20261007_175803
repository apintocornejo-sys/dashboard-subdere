function refreshFilterOptions() {
  const provinciaSel = multiselectState['f-provincia'];
  const base = provinciaSel.size ? RAW_DATA.filter(d => provinciaSel.has(d.provincia)) : RAW_DATA;
  populateMultiselect('f-provincia', unique(RAW_DATA, 'provincia'));
  populateMultiselect('f-comuna', unique(base, 'comuna'));
  populateMultiselect('f-programa', unique(RAW_DATA, 'programa'));
  populateMultiselect('f-estado', unique(RAW_DATA, 'estado'));
  populateMultiselect('f-evento-filtro', unique(RAW_DATA, 'evento'));
  populateMultiselect('f-anio', unique(RAW_DATA, 'anio_aprobacion').map(String));
  populateMultiselect('f-anio-postulacion', unique(RAW_DATA, 'anio_postulacion').map(String));
}

function applyFilters() {
  const f = {
    provincia: multiselectState['f-provincia'],
    comuna: multiselectState['f-comuna'],
    programa: multiselectState['f-programa'],
    estado: multiselectState['f-estado'],
    evento: multiselectState['f-evento-filtro'],
    anio: multiselectState['f-anio'],
    anioPostulacion: multiselectState['f-anio-postulacion'],
  };
  filtered = RAW_DATA.filter(d =>
    (!f.provincia.size || f.provincia.has(d.provincia)) &&
    (!f.comuna.size || f.comuna.has(d.comuna)) &&
    (!f.programa.size || f.programa.has(d.programa)) &&
    (!f.estado.size || f.estado.has(d.estado)) &&
    (!f.evento.size || f.evento.has(d.evento)) &&
    (!f.anio.size || f.anio.has(String(d.anio_aprobacion))) &&
    (!f.anioPostulacion.size || f.anioPostulacion.has(String(d.anio_postulacion)))
  );
  document.querySelectorAll('.multiselect-panel.open').forEach(p => p.classList.remove('open'));
  tablaPage = 0;
  renderAll();
}

function clearFilters() {
  Object.keys(multiselectState).forEach(id => multiselectState[id].clear());
  filtered = RAW_DATA;
  refreshFilterOptions();
  tablaPage = 0;
  renderAll();
}

// ---------- Agregaciones ----------
function groupBy(arr, key) {
  const m = new Map();
  for (const d of arr) {
    const k = d[key] ?? 'Sin dato';
    if (!m.has(k)) m.set(k, { n:0, monto:0 });
    const g = m.get(k);
    g.n++; g.monto += (d.monto_subdere || 0);
  }
  return [...m.entries()].map(([k,v]) => ({ key:k, n:v.n, monto:v.monto }));
}

function aplicarDrilldown(campo, valor) {
  const idFiltro = { provincia: 'f-provincia', comuna: 'f-comuna', programa: 'f-programa', estado: 'f-estado', evento: 'f-evento-filtro' }[campo];
  if (!idFiltro || !multiselectState[idFiltro]) return;
  multiselectState[idFiltro].clear();
  multiselectState[idFiltro].add(valor);
  refreshFilterOptions();
  applyFilters();
  const buscadorTabla = document.getElementById('tabla-search');
  if (buscadorTabla) buscadorTabla.value = '';
  const tabTabla = document.querySelector('.tab[data-view="tabla"]');
  if (tabTabla) tabTabla.click();
}

function makeChart(id, type, labels, datasets, opts={}) {
  if (charts[id]) charts[id].destroy();

  const isHorizontal = opts.indexAxis === 'y';
  const datalabelsByType = {
    bar: { anchor: 'end', align: isHorizontal ? 'right' : 'top', offset: 2 },
    line: { anchor: 'end', align: 'top', offset: 4 },
    doughnut: { color: '#2F2620', backgroundColor: 'rgba(245,240,232,0.92)', borderRadius: 4, padding: {top:2,bottom:2,left:5,right:5}, font: { size: 10, weight: '700' } },
  };
  const defaultLegendOn = type === 'doughnut' || datasets.length > 1;
  const baseScales = type === 'doughnut' ? {} : {
    x: { grid: { color: '#4f3f33' } },
    y: { grid: { color: '#4f3f33' }, beginAtZero: true },
  };
  const userPlugins = opts.plugins || {};
  const drilldownCampo = opts.drilldownCampo || null;
  const canvasEl = document.getElementById(id);
  if (drilldownCampo || opts.onClick) canvasEl.style.cursor = 'pointer';

  charts[id] = new Chart(canvasEl, {
    type, data: { labels, datasets },
    options: Object.assign({
      responsive: true,
      maintainAspectRatio: false,
      scales: baseScales,
      onClick: drilldownCampo ? (evt, elements) => {
        if (!elements.length) return;
        const idx = elements[0].index;
        aplicarDrilldown(drilldownCampo, labels[idx]);
      } : undefined,
    }, opts, {
      plugins: Object.assign(
        { legend: { display: defaultLegendOn, position: 'bottom' } },
        userPlugins,
        { datalabels: Object.assign({}, datalabelsByType[type] || {}, userPlugins.datalabels || {}) }
      ),
    }),
  });
}

