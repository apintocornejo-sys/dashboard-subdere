    ...detalle.map(p => [v(p.provincia), v(p.comuna), v(p.programa), v(p.subprograma), v(p.id_proyecto), v(p.nombre), v(p.monto_asignado), v(p.monto_contratado), v(p.monto_vigente),
      v(p.saldo_contable), v(p.saldo_por_transferir), v(p.saldo_por_rendir), v(p.plazo_ejecucion), v(p.estado_seg), v(p.avance_fisico), v(p.rendicion_ejec), v(p.por_rendir_ejec), v(p.venc_garantia)]),
  ]);
  wsD['!cols'] = [{ wch: 10 }, { wch: 16 }, { wch: 36 }, { wch: 28 }, { wch: 16 }, { wch: 60 }, ...Array(6).fill({ wch: 18 }), { wch: 14 }, { wch: 34 }, { wch: 12 }, { wch: 22 }, { wch: 22 }, { wch: 22 }];
  for (let c = 6; c <= 11; c++) formatearColumnaXLS(wsD, c, FMT, 1, detalle.length);
  for (let c = 15; c <= 16; c++) formatearColumnaXLS(wsD, c, FMT, 1, detalle.length);
  XLSX.utils.book_append_sheet(wb, wsD, 'Proyectos');
  if (disp.garantia) {   // hoja de boletas de garantía: todas las que tienen fecha, con su situación
    const conFecha = f.filter(p => p.venc_garantia).sort((a, b) => a.venc_garantia.localeCompare(b.venc_garantia));
    const situacion = p => !rfGarantiaActiva(p) ? 'Proyecto cerrado / sin efecto' : p.venc_garantia < gar.hoy ? 'Vencida' : p.venc_garantia <= gar.d30 ? 'Vence en 30 días' : p.venc_garantia <= gar.d60 ? 'Vence en 31 a 60 días' : 'Vigente (más de 60 días)';
    const wsG = XLSX.utils.aoa_to_sheet([['Situación', 'Comuna', 'Id. Proyecto', 'Nombre', 'Estado Real', 'Estado (informe financiero)', 'Fecha vencimiento boleta', 'Días para vencer', 'Saldo por Rendir ($)'],
      ...conFecha.map(p => [situacion(p), v(p.comuna), v(p.id_proyecto), v(p.nombre), v(p.estado_seg), v(p.estado_real), p.venc_garantia, rfDias(gar.hoy, p.venc_garantia), v(p.saldo_por_rendir)])]);
    wsG['!cols'] = [{ wch: 28 }, { wch: 16 }, { wch: 16 }, { wch: 60 }, { wch: 30 }, { wch: 28 }, { wch: 18 }, { wch: 14 }, { wch: 20 }]; formatearColumnaXLS(wsG, 8, FMT, 1, conFecha.length);
    XLSX.utils.book_append_sheet(wb, wsG, 'Boletas de Garantía');
  }
  XLSX.writeFile(wb, `informe_rendiciones_${new Date().toISOString().slice(0, 10)}.xlsx`);
}

