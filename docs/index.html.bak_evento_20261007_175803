// ---------- Filtros (selección múltiple) ----------
function unique(arr, key) {
  return [...new Set(arr.map(d => d[key]).filter(v => v !== null && v !== undefined && v !== ''))].sort();
}

const FILTER_LABELS = {
  'f-provincia': 'Todas', 'f-comuna': 'Todas', 'f-programa': 'Todos',
  'f-estado': 'Todos', 'f-evento-filtro': 'Todos', 'f-anio': 'Todos', 'f-anio-postulacion': 'Todos',
};
const multiselectState = {}; // { [id]: Set(valores seleccionados) }
Object.keys(FILTER_LABELS).forEach(id => multiselectState[id] = new Set());

function populateMultiselect(id, values) {
  const container = document.getElementById(id);
  const panel = container.querySelector('.multiselect-panel');
  const selected = multiselectState[id];
  // Descarta selecciones que ya no existan en las opciones disponibles (ej: comuna al cambiar provincia)
  [...selected].forEach(v => { if (!values.includes(v)) selected.delete(v); });

  panel.innerHTML = values.map(v => `
    <label class="multiselect-option">
      <input type="checkbox" value="${String(v).replace(/"/g,'&quot;')}" ${selected.has(v) ? 'checked' : ''} onchange="onMultiselectChange('${id}', this)">
      <span>${v}</span>
    </label>`).join('') +
    `<div class="multiselect-actions">
       <button type="button" onclick="setAllMultiselect('${id}', true)">Todos</button>
       <button type="button" onclick="setAllMultiselect('${id}', false)">Ninguno</button>
     </div>`;

  updateMultiselectLabel(id);
}

function updateMultiselectLabel(id) {
  const btn = document.querySelector(`#${id} .multiselect-btn`);
  const selected = multiselectState[id];
  if (selected.size === 0) btn.textContent = FILTER_LABELS[id];
  else if (selected.size === 1) btn.textContent = [...selected][0];
  else btn.textContent = `${selected.size} seleccionados`;
}

function onMultiselectChange(id, checkbox) {
  const selected = multiselectState[id];
  if (checkbox.checked) selected.add(checkbox.value); else selected.delete(checkbox.value);
  updateMultiselectLabel(id);
  if (id === 'f-provincia') {
    multiselectState['f-comuna'].clear();
    const base = selected.size ? RAW_DATA.filter(d => selected.has(d.provincia)) : RAW_DATA;
    populateMultiselect('f-comuna', unique(base, 'comuna'));
  }
}

function setAllMultiselect(id, checkAll) {
  const container = document.getElementById(id);
  const boxes = container.querySelectorAll('.multiselect-panel input[type=checkbox]');
  const selected = multiselectState[id];
  boxes.forEach(b => { b.checked = checkAll; if (checkAll) selected.add(b.value); });
  if (!checkAll) selected.clear();
  updateMultiselectLabel(id);
  if (id === 'f-provincia') {
    multiselectState['f-comuna'].clear();
    const base = selected.size ? RAW_DATA.filter(d => selected.has(d.provincia)) : RAW_DATA;
    populateMultiselect('f-comuna', unique(base, 'comuna'));
  }
}

function toggleMultiselect(id) {
  const panel = document.querySelector(`#${id} .multiselect-panel`);
  const isOpen = panel.classList.contains('open');
  document.querySelectorAll('.multiselect-panel.open').forEach(p => p.classList.remove('open'));
  if (!isOpen) panel.classList.add('open');
}

document.addEventListener('click', (e) => {
