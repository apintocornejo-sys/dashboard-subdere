    return `<div class="rf-campo"><label>${def.t}</label>
      <div class="rf-ms${RF.abierto === def.id ? ' abierto' : ''}" id="rf-ms-${def.id}">
        <button type="button" class="rf-ms-btn${sel.size ? ' activo' : ''}" onclick="rfMsAbrir('${def.id}', event)"><span>${rfEsc(txt)}</span><span>▾</span></button>
        <div class="rf-ms-panel" onclick="event.stopPropagation()">
