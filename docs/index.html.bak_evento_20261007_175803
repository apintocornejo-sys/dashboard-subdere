          <td class="num">${fmtCLP(e.monto)}</td>
          <td class="num">${fmtPctGR(totales.postulado ? e.monto / totales.postulado : 0)}</td>
        </tr>`).join('')
    : '<tr><td colspan="4" style="text-align:center;color:var(--ink-dim);padding:14px">Sin proyectos del evento en la vista actual.</td></tr>';
}

// Clic en una comuna: lleva a la Tabla dinámica con sus proyectos del evento.
function irATablaGR2026(comuna) {
  ['f-provincia', 'f-comuna', 'f-evento-filtro'].forEach(id => multiselectState[id].clear());
  multiselectState['f-evento-filtro'].add(EVENTO_GR_2026);
  multiselectState['f-comuna'].add(comuna);
  refreshFilterOptions();
  applyFilters();
  const buscadorTabla = document.getElementById('tabla-search');
  if (buscadorTabla) buscadorTabla.value = '';
  const tabTabla = document.querySelector('.tab[data-view="tabla"]');
  if (tabTabla) tabTabla.click();
}

