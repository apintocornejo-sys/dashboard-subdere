function renderIndicadoresModoReunion() {
  // PMB Tradicional / Tradicional, año de postulación 2026
  const PROGRAMAS_TRAD = ['PMB Tradicional', 'Tradicional'];
  const elTrad = document.getElementById('indicadores-tradicional-2026');
  const detalleTrad = document.getElementById('indicador-tradicional-detalle');
  elTrad.innerHTML = PROGRAMAS_TRAD.map(programa => {
    const n = filtered.filter(d => d.programa === programa && String(d.anio_postulacion) === '2026').length;
    const activo = indicadorExpandido && indicadorExpandido.tipo === 'programaTrad' && indicadorExpandido.valor === programa;
    return `<div class="profesional-card indicador-neutro${activo ? ' expandido' : ''}" onclick="toggleIndicadorDetalle('programaTrad', '${programa.replace(/'/g,"\\'")}')"><div class="num">${numeroReloj(n)}</div><div class="name">${programa}</div></div>`;
  }).join('');

  if (indicadorExpandido && indicadorExpandido.tipo === 'programaTrad') {
    const lista = filtered.filter(d => d.programa === indicadorExpandido.valor && String(d.anio_postulacion) === '2026');
    detalleTrad.innerHTML = `<div class="profesional-detalle-panel"><h3>${indicadorExpandido.valor} — Año Postulación 2026 (${lista.length})</h3>${tablaDetalleIndicador(lista)}</div>`;
  } else {
    detalleTrad.innerHTML = '';
  }

  // Un indicador por cada evento con proyectos (mismos datos del gráfico
  // "Distribución por evento" del Resumen).
  const proyectosConEvento = filtered.filter(d => d.evento && d.evento.trim() !== '');
  const porEvento = groupBy(proyectosConEvento, 'evento').sort((a,b) => b.n - a.n);
  const elEventos = document.getElementById('indicadores-eventos');
  const detalleEventos = document.getElementById('indicador-eventos-detalle');
  if (porEvento.length === 0) {
    elEventos.innerHTML = '<div style="color:var(--ink-dim);font-size:0.85rem;padding:8px 0">Sin proyectos con evento asignado en la vista actual.</div>';
    detalleEventos.innerHTML = '';
  } else {
    elEventos.innerHTML = porEvento.map(({key, n}) => {
      const activo = indicadorExpandido && indicadorExpandido.tipo === 'evento' && indicadorExpandido.valor === key;
      return `<div class="profesional-card indicador-neutro${activo ? ' expandido' : ''}" onclick="toggleIndicadorDetalle('evento', '${key.replace(/'/g,"\\'")}')"><div class="num">${numeroReloj(n)}</div><div class="name">${key}</div></div>`;
    }).join('');

    if (indicadorExpandido && indicadorExpandido.tipo === 'evento') {
      const lista = proyectosConEvento.filter(d => d.evento === indicadorExpandido.valor);
      detalleEventos.innerHTML = `<div class="profesional-detalle-panel"><h3>${indicadorExpandido.valor} (${lista.length})</h3>${tablaDetalleIndicador(lista)}</div>`;
