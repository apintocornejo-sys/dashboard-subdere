          <div class="rf-ms-lista">${ops.map((v, i) => `<label data-t="${rfEsc(rfNorm(v))}"${q && !rfNorm(v).includes(q) ? ' style="display:none"' : ''}><input type="checkbox"${sel.has(v) ? ' checked' : ''} onchange="rfMsMarcar('${def.id}', ${i}, this.checked)"><span>${rfEsc(v)}</span></label>`).join('')}</div>
