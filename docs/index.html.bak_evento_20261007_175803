  return String(n).split('').map(c =>
    /[0-9]/.test(c) ? `<span class="flip-digito">${c}</span>` : `<span class="flip-separador">${c}</span>`
  ).join('');
}

function circuloUrgencia(dias) {
  const n = Number(dias);
  if (isNaN(n)) return '';
  if (n > 20) return '<span class="circulo-urgencia" style="background:#D4553C" title="Más de 20 días"></span>';
  if (n >= 11) return '<span class="circulo-urgencia" style="background:#e6b52e" title="11 a 20 días"></span>';
  return '';
}

let indicadorExpandido = null; // { tipo: 'programaTrad' | 'evento', valor: string }

function toggleIndicadorDetalle(tipo, valor) {
  indicadorExpandido = (indicadorExpandido && indicadorExpandido.tipo === tipo && indicadorExpandido.valor === valor)
