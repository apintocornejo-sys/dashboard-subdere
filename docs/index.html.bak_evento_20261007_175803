  document.getElementById('rf-reu-lbl-anio').textContent = aprob ? 'Año de Aprobación' : 'Año de Postulación';
  const anios = [...new Set(todos.map(p => p[campoAnio]).filter(Boolean))].sort((a, b) => b - a);
  const comunasTodas = [...new Set(todos.map(p => p.comuna).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'es'));
  const selA = document.getElementById('rf-reu-anio'), selC = document.getElementById('rf-reu-comuna');
  selA.innerHTML = '<option value="">Todos</option>' + anios.map(a => `<option value="${a}"${RF.filtros[claveAnio].has(a) ? ' selected' : ''}>${a}</option>`).join('');
  selC.innerHTML = '<option value="">Todas</option>' + comunasTodas.map(c => `<option value="${rfEsc(c)}"${RF.filtros.comuna.has(c) ? ' selected' : ''}>${rfEsc(rfTitulo(c))}</option>`).join('');
  document.getElementById('rf-reu-soloseg-wrap').style.display = disp.seguimiento ? '' : 'none';
  document.getElementById('rf-reu-soloseg').checked = !!RF.filtros.soloSeg;
  const otros = rfResumenFiltros().split(' · ').filter(t => !/^(Comuna|Año (Aprobación|Postulación)|Solo seguimiento)/.test(t));
  document.getElementById('rf-reu-nota').innerHTML = otros.length && otros[0] !== 'Sin filtros aplicados (todos los proyectos)'
    ? `Otros filtros activos: ${rfEsc(otros.join(' · '))} <a onclick="rfLimpiarFiltros()">Quitar todos</a>` : '';

  // 1) Proyectos por comuna (cantidad)
  const porComuna = rfAgregar(f, 'comuna').sort((a, b) => b.n - a.n);
  rfBarras('chartRfReuComuna', porComuna.map(c => rfTitulo(c.key)), porComuna.map(c => c.n),
    { fuente: FU, fmt: v => v.toLocaleString('es-CL'), tooltipFmt: v => v + ' proyectos', color: '#6FA3B5', nombre: 'Proyectos', rotar: 40, truncar: 20 });

  // 2) Estado Real: el de "Datos adicionales"; si aún no hay, la columna de estado del informe financiero; si no, el del listado de proyectos
  const hayEstadoSeg = f.some(p => p.estado_seg), hayEstadoInf = f.some(p => p.estado_real);
  const estados = rfAgregar(f, p => hayEstadoSeg ? (p.estado_seg || 'Sin estado') : hayEstadoInf ? (p.estado_real || 'Sin estado') : ((mapa.get(p.id_proyecto) || {}).estado || 'Sin estado'));
  estados.sort((a, b) => { const x = rfEstadoNum(a.key), y = rfEstadoNum(b.key); return x === null && y === null ? b.n - a.n : x === null ? -1 : y === null ? 1 : y - x; });
  const hdrEstado = String(((RENDICIONES.columnas_detectadas || {}).estado_real) || '');
  document.getElementById('rf-reu-t-estado').textContent = hayEstadoSeg ? 'Estado Real' : !hayEstadoInf ? 'Estado del proyecto (según el listado de proyectos)'
    : (rfNorm(hdrEstado) === 'estado real' ? 'Estado Real' : `Estado del proyecto (columna "${hdrEstado}" del informe financiero)`);
  rfBarras('chartRfReuEstado', estados.map(e => e.key), estados.map(e => e.n),
    { fuente: FU, fmt: v => v.toLocaleString('es-CL'), tooltipFmt: v => v + ' proyectos', color: '#6FA3B5', nombre: 'Proyectos', rotar: 40, truncar: 24 });

  // 3) "Por rendir": conforme a % de ejecución si hay % de avance cargado; si no, el Saldo por Rendir del informe
  const medida = disp.avance ? 'ejec' : 'saldoRendir', hayMedida = disp.avance || disp.saldo_por_rendir;
  document.getElementById('rf-reu-tab-prov').innerHTML = rfReuTabla(rfOrdenarProvincias(rfAgregar(f, 'provincia')), 'Provincia', disp, medida);
  document.getElementById('rf-reu-tab-prog').innerHTML = rfReuTabla(rfAgregar(f, 'programa').map(r => Object.assign(r, { etq: rfSigla(r.key) })).sort((a, b) => b.n - a.n), 'Programa', disp, medida);
  const rend = rfAgregar(f, 'comuna').sort((a, b) => b[medida] - a[medida]);
  document.getElementById('rf-reu-t-porrendir').textContent = disp.avance ? 'Por Rendir conforme a % de ejecución, por comuna' : 'Por Rendir por comuna (Saldo por Rendir del informe)';
  rfReuDisponible('PorRendir', hayMedida, 'El informe no trae el Saldo por Rendir');
  if (hayMedida) rfBarras('chartRfReuPorRendir', rend.map(c => rfTitulo(c.key)), rend.map(c => c[medida]),
    { horizontal: true, fuente: FU, fmt: v => rfCompacto(v), tooltipFmt: v => fmtCLPn(v), color: RF_COLOR.saldo_por_rendir, nombre: 'Por rendir', partir: 18, derecha: 120 });

  // 4) Plazo: Sin iniciar (estados 01 a 10 del Estado Real) / plazo vencido / plazo vigente (según la fecha de término del informe)
  const hayNum = f.some(p => rfEstadoNum(rfEstadoRealDe(p)) !== null), hoy = rfHoy();
  const cat = { 'Con Plazo Vencido': 0, 'Sin Iniciar': 0, 'Con Plazo Vigente': 0 };
  f.forEach(p => { const n = rfEstadoNum(rfEstadoRealDe(p)); if (hayNum && n !== null && n <= 10) cat['Sin Iniciar']++; else if (p.fecha_termino) cat[p.fecha_termino < hoy ? 'Con Plazo Vencido' : 'Con Plazo Vigente']++; });
  const plazoOk = disp.fecha_termino && (cat['Con Plazo Vencido'] + cat['Con Plazo Vigente'] + cat['Sin Iniciar']) > 0;
  rfReuDisponible('Plazo', plazoOk, 'El informe no trae fechas de término');
  const nombresPlazo = Object.keys(cat).filter(k => hayNum || k !== 'Sin Iniciar');
  if (plazoOk) rfBarras('chartRfReuPlazo', nombresPlazo, nombresPlazo.map(k => cat[k]),
    { horizontal: true, fuente: FU, fmt: v => v.toLocaleString('es-CL'), tooltipFmt: v => v + ' proyectos', nombre: 'Proyectos', partir: 16, alto: 230, derecha: 80,
      colores: nombresPlazo.map(k => k === 'Con Plazo Vencido' ? '#C8643C' : k === 'Sin Iniciar' ? '#D8C3A5' : '#8FA37E') });
  document.getElementById('rf-reu-nota-plazo').textContent = hayNum ? '' : "'Sin Iniciar' requiere el Estado Real numerado (01 a 14): se carga en Datos adicionales.";

  // 5) ¿Con contrato en plataforma? De más a menos directo: Datos adicionales > columna del informe > Contratos Registrados > Monto Contratado
  const hayCS = f.some(p => p.contrato_seg), hayCP = f.some(p => p.contrato_plataforma), hayCR = f.some(p => p.contratos_registrados !== undefined && p.contratos_registrados !== null);
  const conContrato = p => hayCS ? p.contrato_seg === 'SI' : hayCP ? p.contrato_plataforma === 'SI' : hayCR ? rfNum(p.contratos_registrados) > 0 : rfNum(p.monto_contratado) > 0;
  const si = f.filter(conContrato).length, no = f.length - si;
  const contOk = hayCS || hayCP || hayCR || disp.monto_contratado;
  rfReuDisponible('Contrato', contOk, 'El informe no trae contratos ni Monto Contratado');
  if (contOk) makeChart('chartRfReuContrato', 'doughnut', ['SI', 'NO'], [{ data: [si, no], backgroundColor: ['#5FB3A7', '#D9A441'], borderColor: '#2F2620', borderWidth: 2 }], {
    cutout: 0,
    plugins: { legend: { position: 'bottom', labels: { color: RF_TINTA, font: { size: FU.leyenda }, padding: 16 } },
               datalabels: { formatter: v => v ? v : '', color: '#1f1915', font: { size: FU.dato + 4, weight: '800' }, backgroundColor: 'rgba(245,240,232,0.92)', borderRadius: 6, padding: 4 } } });
  document.getElementById('rf-reu-nota-contrato').textContent = hayCS ? '' : hayCP ? '' : hayCR ? 'SI = con "Contratos Registrados" mayor a cero (según el informe financiero).' : 'SI = con Monto Contratado mayor a cero.';

  // 6) Boletas de garantía (fecha de vencimiento ingresada en Datos adicionales)
  rfReuDisponible('Garantia', disp.garantia, 'Aún no hay fechas de vencimiento (se cargan en Datos adicionales)');
  if (disp.garantia) {
    const b = rfBucketsGarantia(f), nombresG = Object.keys(b), colG = { 'Vencidas': '#C8643C', 'Vencen en 30 días': '#F2C14E', 'En 31 a 60 días': '#D9A441', 'En 61 a 90 días': '#8FA37E', 'Más de 90 días': '#6FA3B5', 'Sin fecha': '#BCAA95' };
    rfBarras('chartRfReuGarantia', nombresG, nombresG.map(k => b[k]), { horizontal: true, fuente: FU, fmt: v => v.toLocaleString('es-CL'), tooltipFmt: v => v + ' proyectos', nombre: 'Proyectos', partir: 16, alto: 300, derecha: 80, colores: nombresG.map(k => colG[k]) });
  }

  // 7) Proyectos clasificados según evento (el de Datos adicionales; si falta, el del listado de proyectos)
  const ev = rfAgregar(f, p => p.evento_seg || (mapa.get(p.id_proyecto) || {}).evento || 'Sin evento').sort((a, b) => (a.key === 'Sin evento') - (b.key === 'Sin evento') || b.n - a.n).slice(0, 14);
  const evOk = mapa.size > 0 || f.some(p => p.evento_seg);
  rfReuDisponible('Evento', evOk, 'Cargando el listado de proyectos…');
  if (evOk) rfBarras('chartRfReuEvento', ev.map(x => x.key), ev.map(x => x.n),
    { horizontal: true, fuente: FU, fmt: v => v.toLocaleString('es-CL'), tooltipFmt: v => v + ' proyectos', color: '#D9A441', nombre: 'Proyectos', partir: 20, derecha: 80 });
}

