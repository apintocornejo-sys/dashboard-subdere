  const campoAnio = disp.anio_aprobacion ? 'anio_aprobacion' : 'anio_postulacion';
  hojaAgg(disp.anio_aprobacion ? 'Por Año Aprobación' : 'Por Año Postulación', disp.anio_aprobacion ? 'Año de aprobación' : 'Año de postulación', rfAgregar(f, campoAnio).sort((a, b) => a.key - b.key));

  if (disp.fecha_termino) {
    const filasPl = [...pl.venc.map(p => ['Plazo vencido', p]), ...pl.porv.map(p => ['Vence en 30 días', p])];
    const wsP = XLSX.utils.aoa_to_sheet([['Alerta', 'Comuna', 'Id. Proyecto', 'Nombre', 'Fecha de término', 'Término estimado', 'Saldo por Rendir ($)'],
