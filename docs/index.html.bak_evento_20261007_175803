function resumenFiltrosActivos() {
  const labels = {
    'f-provincia': 'Provincia', 'f-comuna': 'Comuna', 'f-programa': 'Programa',
    'f-estado': 'Estado', 'f-evento-filtro': 'Evento', 'f-anio': 'Año Aprobación', 'f-anio-postulacion': 'Año Postulación',
  };
  const partes = Object.keys(labels).map(id => {
    const sel = multiselectState[id];
    if (!sel || sel.size === 0) return null;
    return `${labels[id]}: ${[...sel].join(', ')}`;
  }).filter(Boolean);
  return partes.length ? partes.join('   |   ') : 'Sin filtros aplicados (todos los proyectos)';
}

