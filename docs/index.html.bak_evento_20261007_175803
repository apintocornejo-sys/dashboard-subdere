function rfDescargarPDF() {
  if (!(RENDICIONES && RENDICIONES.proyectos && RENDICIONES.proyectos.length)) { alert('Aún no hay datos de Rendiciones.'); return; }
  const { jsPDF } = window.jspdf, logo = new Image();
  logo.onload = () => rfPDFSeguro(jsPDF, logo.naturalWidth, logo.naturalHeight);
  logo.onerror = () => rfPDFSeguro(jsPDF, null, null);
  logo.src = `data:image/jpeg;base64,${LOGO_BASE64}`;
}
function rfPDFSeguro(jsPDF, w, h) {
  try { rfGenerarPDF(jsPDF, w, h); } catch (err) { console.error('Error generando el PDF de Rendiciones:', err); alert('No se pudo generar el PDF: ' + err.message); }
}
function rfGenerarPDF(jsPDF, logoW, logoH) {
  const f = rfFiltrados(), disp = rfDisp(), T = rfTotales(f), pl = rfClasificarPlazos(f, disp);
  const nombreMetrica = RF_METRICAS.find(m => m[0] === RF.metrica)[1];
  const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'letter' });
  doc.setFont('helvetica', 'normal');
  const mx = 14, pageW = 279.4, pageH = 215.9, cw = pageW - mx * 2;
  const azul = { fillColor: [35, 49, 108], textColor: [255, 255, 255] }, rojo = { textColor: [190, 40, 60], fontStyle: 'bold' };
  const titulo = (txt, y) => { doc.setFontSize(10); doc.setTextColor(35, 49, 108); doc.setFont(undefined, 'bold'); doc.text(txt, mx, y); doc.setFont(undefined, 'normal'); };
  let textoX = mx;
  if (logoW && logoH) { const ah = 15, an = ah * (logoW / logoH); doc.addImage(`data:image/jpeg;base64,${LOGO_BASE64}`, 'JPEG', mx, 8, an, ah); textoX = mx + an + 6; }
  doc.setFont(undefined, 'bold'); doc.setFontSize(14); doc.setTextColor(35, 49, 108); doc.text('SUBDERE en Línea', textoX, 13);
  doc.setFontSize(11); doc.setTextColor(70, 80, 120); doc.text('Rendiciones — Situación financiera de los proyectos', textoX, 19.5);
  doc.setFont(undefined, 'normal'); doc.setFontSize(8.5); doc.setTextColor(110, 110, 110);
  const act = RENDICIONES.fecha_actualizacion ? ` · Informe de SUBDERE en Línea del ${rfFecha(RENDICIONES.fecha_actualizacion)}${RENDICIONES.hora_actualizacion ? ' ' + RENDICIONES.hora_actualizacion : ''}` : '';
  doc.text(`Generado el ${new Date().toLocaleDateString('es-CL')}${act}`, textoX, 25);
  let y = 30;
  doc.setFontSize(8);
  const lineasF = doc.splitTextToSize(`Filtros aplicados: ${rfResumenFiltros()}`, cw - 8).slice(0, 2), hF = 6 + lineasF.length * 4;
  doc.setFillColor(24, 34, 74); doc.setDrawColor(70, 90, 160); doc.roundedRect(mx, y, cw, hF, 1.5, 1.5, 'FD');
  doc.setTextColor(210, 216, 240); doc.text(lineasF, mx + 4, y + 5); y += hF + 5;

  const nd = txt => txt;   // montos que el informe no trae se muestran como "—"
  const kpis = [
    { l: 'Proyectos', v: T.n.toLocaleString('es-CL'), c: [120, 130, 150] },
    { l: 'Monto Asignado', v: disp.monto_asignado ? fmtCLPn(T.asignado) : '—', c: [217, 164, 65] },
    { l: 'Monto Contratado', v: disp.monto_contratado ? fmtCLPn(T.contratado) : '—', c: [111, 163, 181] },
    { l: 'Monto Vigente', v: disp.monto_vigente ? fmtCLPn(T.vigente) : '—', c: [143, 163, 126] },
    { l: 'Saldo Contable (Asignado - Contratado)', v: disp.saldo_contable ? fmtCLPn(T.saldoContable) : '—', c: [176, 138, 106] },
    { l: 'Saldo por Transferir (Contratado - Transferido)', v: disp.saldo_por_transferir ? fmtCLPn(T.saldoTransferir) : '—', c: [176, 122, 161] },
    { l: 'Saldo por Rendir', v: disp.saldo_por_rendir ? fmtCLPn(T.saldoRendir) : '—', c: [118, 106, 205] },
    { l: disp.fecha_termino ? 'Plazo vencido con saldo / vence en 30 días' : 'Plazos de ejecución', v: disp.fecha_termino ? `${pl.venc.length} / ${pl.porv.length}` : 'sin fechas', c: [200, 100, 60] },
  ];
  const gap = 6, kw = (cw - gap * 3) / 4, kh = 20;
  kpis.forEach((k, i) => {
    const kx = mx + (i % 4) * (kw + gap), ky = y + Math.floor(i / 4) * (kh + gap);
    doc.setFillColor(245, 246, 249); doc.setDrawColor(225, 227, 232); doc.roundedRect(kx, ky, kw, kh, 1.5, 1.5, 'FD');
    doc.setFillColor(k.c[0], k.c[1], k.c[2]); doc.roundedRect(kx, ky, 2.2, kh, 1, 1, 'F');
    doc.setFontSize(12.5); doc.setTextColor(k.c[0], k.c[1], k.c[2]); doc.setFont(undefined, 'bold'); doc.text(k.v, kx + 6, ky + 10.5, { maxWidth: kw - 8 });
    doc.setFont(undefined, 'normal'); doc.setFontSize(7.2); doc.setTextColor(90, 90, 95); doc.text(k.l, kx + 6, ky + 16, { maxWidth: kw - 8 });
  });
  y += 2 * kh + gap + 8;

  const colsAgg = ['N°', 'Asignado ($)', 'Contratado ($)', 'Vigente ($)', 'Saldo Contable ($)', 'Saldo por Transferir ($)', 'Saldo por Rendir ($)'];
  const filaAgg = (r, nombre) => [nombre ?? r.key, r.n.toLocaleString('es-CL'), fmtCLPn(r.asignado), fmtCLPn(r.contratado), fmtCLPn(r.vigente),
    { content: fmtCLPn(r.saldoContable), styles: r.saldoContable < 0 ? rojo : {} }, { content: fmtCLPn(r.saldoTransferir), styles: r.saldoTransferir < 0 ? rojo : {} },
    { content: fmtCLPn(r.saldoRendir), styles: r.saldoRendir < 0 ? rojo : {} }];
  const tablaAgg = (inicioY, nombreCol, filas, conTotal) => doc.autoTable({
    startY: inicioY, margin: { left: mx, right: mx }, head: [[nombreCol, ...colsAgg]], body: filas.map(r => filaAgg(r)),
    foot: conTotal ? [filaAgg(Object.assign({ key: 'TOTAL' }, T)).map(c => (typeof c === 'object' ? c.content : c))] : undefined,
    styles: { fontSize: 8, cellPadding: 1.5, halign: 'right' }, columnStyles: { 0: { halign: 'left', fontStyle: 'bold' } }, headStyles: azul,
    footStyles: { fillColor: [226, 230, 244], textColor: [20, 20, 20], fontStyle: 'bold' }, didParseCell: d => { if (d.column.index === 0) d.cell.styles.halign = 'left'; },
  });
  titulo('Resumen por provincia', y); tablaAgg(y + 3, 'Provincia', rfOrdenarProvincias(rfAgregar(f, 'provincia')), true);

  // Gráficos (con letra grande y fondo blanco para impresión)
