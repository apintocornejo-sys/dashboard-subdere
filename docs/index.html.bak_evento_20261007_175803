    <div class="kpi"><div class="value">${fmtPctGR(totales.pct)}</div><div class="label">% postulado del asignado</div></div>
    <div class="kpi"><div class="value">${totales.n.toLocaleString('es-CL')}</div><div class="label">Proyectos</div></div>
  `;

  // ---- Gráfico: asignado vs. postulado por comuna ----
  makeChart('chartGR2026', 'bar', filas.map(f => f.comuna), [
    { label: 'Asignado', data: filas.map(f => f.asignado), backgroundColor: palette[3], borderRadius: 3 },
    { label: 'Postulado', data: filas.map(f => f.postulado), backgroundColor: palette[0], borderRadius: 3 },
  ], {
